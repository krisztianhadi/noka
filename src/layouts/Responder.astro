---
/**
 * The responder plane's shell (§9): zero JavaScript, one request, no webfont,
 * high contrast, nothing that identifies the owner before the PIN is accepted.
 */
interface Props {
  lang: string;
  title: string;
}

const { lang, title } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <link rel="icon" href="data:," />
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  /*
   * The responder plane's type system.
   *
   * One scale, six sizes, and a rule for each: a stranger reads this page once, worried,
   * on a phone, possibly in poor light. Before this there were eight sizes within three
   * pixels of each other (15.2, 16, 16.8, 17, 18, 19, 24, 28), which is not a hierarchy —
   * a one-pixel difference is invisible, so everything read as equally important, and the
   * phone number — the one thing a visitor actually needs — was the smallest text in the
   * contact block.
   *
   * Base 19px rather than 16: this is read at arm's length, in a hurry.
   */
  :root {
    color-scheme: light;

    /* Type scale, ratio ~1.2 on a 19px base. */
    --t-xs: 0.875rem; /* 14px — metadata: spoken languages, language hint */
    --t-sm: 1rem; /* 16px — relation, owner, alert, language buttons */
    --t-md: 1.1875rem; /* 19px — body copy, notes, labels */
    --t-lg: 1.375rem; /* 22px — section headings */
    --t-phone: 1.625rem; /* 26px — the phone number, the loudest datum in a contact */
    --t-xl: 1.625rem; /* 26px — page heading */
    --t-2xl: 2rem; /* 32px — contact name, the loudest thing here */
    --t-pin: 2.125rem; /* 34px — the PIN input */

    /* Line heights, by job. */
    --lh-tight: 1.2; /* headings */
    --lh-solid: 1.3; /* single-line emphasis (name, phone) */
    --lh-body: 1.55; /* running text */

    /* Spacing, 4px steps. */
    --s1: 0.25rem;
    --s2: 0.5rem;
    --s3: 0.75rem;
    --s4: 1rem;
    --s5: 1.5rem;
    --s6: 2rem;
    --s7: 2.5rem;
    --s8: 3rem;

    --ink: #111;
    --ink-soft: #333;
    --ink-faint: #555;
    --rule: #e5e5e5;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    padding: var(--s5) var(--s5) var(--s7);
    font: var(--t-md) / var(--lh-body) system-ui, -apple-system, 'Segoe UI', sans-serif;
    color: var(--ink);
    background: #fff;
    /* Numbers that do not jump: the PIN, the phone number and any count. */
    font-variant-numeric: tabular-nums;
  }
  main {
    max-width: 32rem;
    margin: 0 auto;
  }

  h1,
  h2 {
    line-height: var(--lh-tight);
    text-wrap: balance;
  }
  h1 {
    /* One line, heading size, whether or not the owner's name is in it. */
    margin: 0 0 var(--s6);
    font-size: var(--t-xl);
  }
  p {
    margin: var(--s2) 0;
  }
  label {
    display: block;
    margin: var(--s5) 0 var(--s2);
    font-size: var(--t-md);
    font-weight: 600;
  }

  input[type='text'],
  input[type='tel'],
  input[inputmode='numeric'] {
    width: 100%;
    padding: var(--s4) var(--s4);
    font: inherit;
    font-size: var(--t-pin);
    font-weight: 600;
    /* The letter-spacing is added after the last digit too, which pushes centred text off
       centre by half a space; the indent puts it back. */
    letter-spacing: 0.18em;
    text-indent: 0.18em;
    text-align: center;
    border: 2px solid var(--ink);
    border-radius: 6px;
  }
  button {
    display: block;
    width: 100%;
    min-height: 3.25rem;
    margin-top: var(--s4);
    padding: 0.9rem var(--s4);
    font: inherit;
    font-size: 1.125rem;
    font-weight: 700;
    color: #fff;
    background: var(--ink);
    border: 2px solid var(--ink);
    border-radius: 6px;
    cursor: pointer;
  }
  .error {
    margin-top: var(--s5);
    padding: 0.9rem var(--s4);
    font-weight: 600;
    color: #7a0000;
    background: #fff;
    border: 2px solid #a00;
    border-radius: 6px;
  }

  /* ── One contact ─────────────────────────────────────────────────────────── */
  .contact {
    padding: var(--s6) 0;
    border-bottom: 2px solid var(--rule);
  }
  /* Read in this order, at these sizes: who they are, how to reach them, then what to do. */
  .name {
    font-size: var(--t-2xl);
    font-weight: 700;
    line-height: var(--lh-solid);
    /* A two-word name across two lines reads better balanced than ragged. */
    text-wrap: balance;
    /* A long name must not push the number off the screen. */
    overflow-wrap: anywhere;
  }
  .relation {
    margin-top: var(--s2);
    font-size: var(--t-sm);
    color: var(--ink-soft);
  }
  .phone {
    margin-top: var(--s4);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: var(--t-phone);
    font-weight: 600;
    line-height: var(--lh-solid);
    /* Easy to read aloud and to copy: this is the point of the page. */
    overflow-wrap: anywhere;
  }
  .phone a {
    color: inherit;
  }
  .notes-heading {
    margin: var(--s7) 0 var(--s3);
    font-size: var(--t-lg);
  }
  .speaks,
  .on-channels {
    margin-top: var(--s3);
    font-size: var(--t-xs);
    color: var(--ink-soft);
    overflow-wrap: anywhere;
  }

  /* ── Actions ─────────────────────────────────────────────────────────────── */
  /* One channel per row: a stranger reads down the list, and a full-width target is easier
     to hit with a shaking hand than two half-width ones side by side. */
  .actions {
    display: grid;
    gap: var(--s3);
    margin-top: var(--s5);
  }
  .actions a {
    min-height: 3.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--s2);
    padding: var(--s2) var(--s3);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: var(--lh-tight);
    text-align: center;
    text-decoration: none;
    color: var(--ink);
    background: #fff;
    border: 2px solid var(--ink);
    border-radius: 6px;
  }
  /* One colour for every mark: a stranger's page reads better in plain black on
     white than in five brand palettes. */
  .actions a svg {
    flex: 0 0 auto;
    display: block;
  }
  /* A phone call is the one thing that always works: it keeps the solid button,
     every other channel is outlined beside it. */
  .actions a.call {
    color: #fff;
    background: var(--ink);
  }

  /* ── Notes, alerts, language ─────────────────────────────────────────────── */
  .notes {
    margin-top: var(--s7);
    padding: var(--s5);
    background: #f6f6f6;
    border: 2px solid #ddd;
    border-radius: 6px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .alert {
    display: flex;
    align-items: flex-start;
    gap: var(--s2);
    margin: var(--s4) 0 0;
    padding: var(--s4);
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--ink);
    background: #fff8e1;
    border: 2px solid var(--ink);
    border-left-width: 6px;
    border-radius: 5px;
  }
  .alert svg {
    flex: 0 0 auto;
    /* Sits on the first line's cap height rather than its ascender. */
    margin-top: -0.15rem;
  }
  .exit {
    margin-top: var(--s5);
    background: #fff;
    color: #7a0000;
    border-color: #a00;
  }
  .langs {
    margin-top: var(--s8);
    padding-top: var(--s5);
    border-top: 1px solid var(--rule);
  }
  .langs > summary {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    /* 44px tall: it is a control, and the previous 39px missed the touch minimum. */
    min-height: 2.75rem;
    padding: var(--s2) 0.7rem;
    font-size: var(--t-sm);
    font-weight: 600;
    cursor: pointer;
    border: 1px solid #ccc;
    border-radius: 5px;
    list-style: none;
  }
  .langs > summary::-webkit-details-marker {
    display: none;
  }
  .langs > summary .hint {
    font-size: var(--t-xs);
    font-weight: 400;
    color: var(--ink-faint);
  }
  .langs[open] > summary {
    margin-bottom: var(--s3);
    border-color: var(--ink);
  }
  .langs form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .langs button {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    width: auto;
    min-height: 2.75rem;
    margin: 0;
    padding: var(--s2) 0.9rem;
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--ink);
    background: #fff;
    border-width: 2px;
  }
  .langs button[aria-current='true'] {
    color: #fff;
    background: var(--ink);
  }
</style>
