---
interface Props {
  title: string;
  lang?: string;
}

const { title, lang = 'en' } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href="data:," />
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
  }
  body {
    margin: 0 auto;
    max-width: 34rem;
    padding: 2rem 1.25rem 4rem;
    font: 1.125rem/1.6 system-ui, sans-serif;
    color: #111;
    background: #fff;
  }
  h1 {
    font-size: 1.6rem;
    margin-top: 0;
  }
  label {
    display: block;
    margin: 1rem 0 0.25rem;
    font-weight: 600;
  }
  input {
    width: 100%;
    box-sizing: border-box;
    padding: 0.6rem 0.7rem;
    font: inherit;
    border: 1px solid #666;
    border-radius: 4px;
  }
  button {
    margin-top: 1.25rem;
    padding: 0.7rem 1.1rem;
    font: inherit;
    font-weight: 600;
    color: #fff;
    background: #111;
    border: 1px solid #111;
    border-radius: 4px;
    cursor: pointer;
  }
  .error {
    margin-top: 1rem;
    padding: 0.7rem 0.8rem;
    border: 2px solid #a00;
    border-radius: 4px;
    color: #7a0000;
  }
  .note {
    margin-top: 1.25rem;
    font-size: 0.95rem;
  }
</style>
