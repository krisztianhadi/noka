---
import Footer from '@/components/Footer.astro';
import { LANGUAGE_INFO } from '@/i18n/languages';
import '@/styles/app.css';

/**
 * The owner plane's shell: landing, auth, dashboard and settings.
 *
 * All styling comes from the token scale in `src/styles/app.css` (ADR-028) — Tailwind
 * utilities over semantic names, so a component cannot invent its own type size,
 * radius or shadow. The responder page has its own layout and never imports this,
 * which is why `/c/*` still carries no utility framework and no third-party anything.
 */
interface Props {
  title: string;
  /** Omitted on pages that always follow the system preference. */
  theme?: 'light' | 'dark' | null;
  /** Wider shell for the dashboard, which lays out cards rather than a form. */
  wide?: boolean;
}

const { title, theme = null, wide = false } = Astro.props;
// The <html lang> comes from the resolved locale, not from the page: a Spanish page marked
// `lang="en"` makes screen readers read Spanish with English pronunciation rules.
const info = LANGUAGE_INFO[Astro.locals.locale];
const lang = info.htmlLang;
const dataTheme = theme ?? undefined;
---

<!doctype html>
<html lang={lang} dir={info.dir} data-theme={dataTheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body class="min-h-dvh">
    <main class:list={['mx-auto w-full px-4 py-8 sm:px-6 sm:py-10', wide ? 'max-w-3xl' : 'max-w-lg']}>
      <slot />
      <Footer />
    </main>
  </body>
</html>
