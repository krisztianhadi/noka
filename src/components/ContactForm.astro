---
import { DEFAULT_COUNTRY } from '@/lib/countries';
import { t } from '@/i18n/catalogue';
import type { ContactView } from '@/lib/contacts';
import Button from '@/components/Button.astro';
import ContactFields from '@/components/ContactFields.astro';
import Icon from '@/components/Icon.astro';

/**
 * A contact, in a form: the shared fields plus a submit row.
 *
 * The first-run page composes ContactFields with the note instead, because there one save
 * button covers both. Everything else — add another, edit — is this component.
 */
interface Props {
  action: string;
  contact?: ContactView | null;
  error?: string;
  submitLabel?: string;
  defaultCountry?: string;
}

const {
  action,
  contact = null,
  error = '',
  submitLabel = 'Save contact',
  defaultCountry = DEFAULT_COUNTRY,
} = Astro.props;

const locale = Astro.locals.locale;
const label = (key: Parameters<typeof t>[1]) => t(locale, key);
---

{
  error && (
    <p class="error mb-4 rounded-md border border-danger/40 bg-danger/10 px-3 py-2 text-sm text-danger" role="alert">
      {error}
    </p>
  )
}

<form method="post" action={action} class="contact-form space-y-4">
  <ContactFields contact={contact} defaultCountry={defaultCountry} />

  <div class="flex items-center justify-end gap-2 pt-1">
    <a
      class="cancel inline-flex h-9 items-center rounded-md border border-line-strong bg-surface px-3.5 text-sm font-medium text-fg no-underline hover:bg-muted"
      href="/dashboard"
      data-cancel
    >
      {label('form.cancel')}
    </a>
    <Button type="submit">
      <Icon name={contact ? 'check' : 'plus'} size={16} />
      {submitLabel}
    </Button>
  </div>
</form>
