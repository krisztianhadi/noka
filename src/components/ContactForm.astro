---
import { COUNTRIES, DEFAULT_COUNTRY, flagFor } from '@/lib/countries';
import { MESSAGES } from '@/i18n/catalogue';
import type { ContactView } from '@/lib/contacts';
import { RELATIONS } from '@/lib/relations';
import { SPOKEN_LANGUAGES } from '@/lib/spoken-languages';

/**
 * The one contact form, used inline for adding and editing.
 *
 * Order and defaults are his (2026-09-29): **call comes first** in the channel list
 * and is on by default; the spoken languages are visible rather than folded away;
 * the country is a flag picker so the number ends up in E.164 without anyone having
 * to know what E.164 means.
 */
interface Props {
  action: string;
  contact?: ContactView | null;
  error?: string;
  submitLabel?: string;
  /** Which country the picker starts on, when the contact has no stored number yet. */
  defaultCountry?: string;
}

const {
  action,
  contact = null,
  error = '',
  submitLabel = 'Save contact',
  defaultCountry = DEFAULT_COUNTRY,
} = Astro.props;

const CHANNEL_ORDER = ['call', 'whatsapp', 'sms', 'signal', 'telegram', 'viber'] as const;
const selectedChannels = new Set(contact?.channels ?? ['call']);
const selectedSpoken = new Set(contact?.spokenLanguages ?? []);
const relationLabel = (relation: string) => MESSAGES.en[`relation.${relation}` as 'relation.spouse'];
const channelLabel = (channel: string) => MESSAGES.en[`channel.${channel}` as 'channel.call'];
const spokenLabel = (code: string) => MESSAGES.en[`spoken.${code}` as 'spoken.en'];

/**
 * A stored number is split back into country + national part where the dial code
 * matches the list, so editing never double-prefixes it.
 */
const stored = contact?.phoneE164 ?? '';
const matched = COUNTRIES.filter((country) => stored.startsWith(`+${country.dial}`)).sort(
  (a, b) => b.dial.length - a.dial.length,
)[0];
const country = matched?.code ?? defaultCountry;
const nationalRaw = matched ? stored.slice(matched.dial.length + 1) : stored.replace(/^\+/, '');
// Grouped exactly as the input mask does, so an edit shows what typing produces.
const national = nationalRaw.replace(/(\d{3})(?=\d)/g, '$1 ').trim();
const uid = contact?.id ?? 'new';
---

{error && <p class="error" role="alert">{error}</p>}

<form method="post" action={action} class="contact-form">
  <div class="row">
    <div>
      <label for={`name-${uid}`}>Name</label>
      <input id={`name-${uid}`} name="name" type="text" required maxlength="80" value={contact?.name ?? ''} />
    </div>
    <div>
      <label for={`relation-${uid}`}>Relation</label>
      <select id={`relation-${uid}`} name="relation" required>
        {
          RELATIONS.map((relation) => (
            <option value={relation} selected={contact?.relation === relation}>
              {relationLabel(relation)}
            </option>
          ))
        }
      </select>
    </div>
  </div>

  <label for={`phone-${uid}`}>Phone</label>
  <div class="phone-row">
    <select name="country" id={`country-${uid}`} aria-label="Country calling code">
      {
        COUNTRIES.map((entry) => (
          <option value={entry.code} selected={entry.code === country}>
            {flagFor(entry.code)} +{entry.dial} {entry.name}
          </option>
        ))
      }
    </select>
    <input
      id={`phone-${uid}`}
      name="phone"
      type="tel"
      required
      autocomplete="tel-national"
      inputmode="tel"
      data-phone
      placeholder="81 234 5678"
      value={national}
    />
  </div>
  <p class="note">
    Pick the country and type the local number — a leading zero is dropped for you. A full
    international number typed with <code>+</code> is used exactly as typed.
  </p>

  <fieldset>
    <legend>How can they be reached?</legend>
    <div class="chips">
      {
        CHANNEL_ORDER.map((channel) => (
          <label class="chip">
            <input type="checkbox" name="channels" value={channel} checked={selectedChannels.has(channel)} />
            <span>{channelLabel(channel)}</span>
          </label>
        ))
      }
    </div>
    <p class="note">
      Every one of these becomes a button on the card page. Text message matters: it is what
      works when someone cannot speak or hear.
    </p>
  </fieldset>

  <fieldset>
    <legend>Languages this contact speaks</legend>
    <div class="chips">
      {
        SPOKEN_LANGUAGES.map((code) => (
          <label class="chip">
            <input type="checkbox" name="spoken" value={code} checked={selectedSpoken.has(code)} />
            <span>{spokenLabel(code)}</span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <button type="submit">{submitLabel}</button>
</form>

<script>
  // Space the number as it is typed, and never eat a deliberate "+": a value that
  // starts with one is already international and is sent as typed.
  for (const input of document.querySelectorAll<HTMLInputElement>('input[data-phone]')) {
    input.addEventListener('input', () => {
      const international = input.value.trimStart().startsWith('+');
      const digits = input.value.replace(/[^\d]/g, '').slice(0, 15);
      input.value = `${international ? '+' : ''}${digits.replace(/(\d{3})(?=\d)/g, '$1 ').trim()}`;
    });
  }
</script>

<style>
  input[type='text'],
  input[type='tel'],
  select {
    width: 100%;
    box-sizing: border-box;
    padding: 0.6rem 0.7rem;
    font: inherit;
    color: var(--fg);
    background: var(--bg-raised);
    border: 1px solid var(--line-strong);
    border-radius: 4px;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
  }
  .row > div {
    flex: 1 1 12rem;
  }
  .phone-row {
    display: flex;
    gap: 0.5rem;
    align-items: stretch;
  }
  .phone-row select {
    flex: 0 0 auto;
    max-width: 15rem;
  }
  .phone-row input {
    flex: 1 1 auto;
  }
  fieldset {
    margin-top: 1rem;
    border: 1px solid var(--line);
    border-radius: 4px;
  }
  legend {
    font-weight: 600;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 400;
    margin: 0;
  }
  .chip input {
    width: auto;
  }
  @media (max-width: 30rem) {
    .phone-row {
      flex-direction: column;
    }
    .phone-row select {
      max-width: none;
    }
  }
</style>
