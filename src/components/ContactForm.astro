---
import type { Channel } from '@/lib/channels';
import { MESSAGES } from '@/i18n/catalogue';
import type { ContactView } from '@/lib/contacts';
import { RELATIONS } from '@/lib/relations';
import { SPOKEN_LANGUAGES } from '@/lib/spoken-languages';

/**
 * One form for creating and editing a contact, used inline on the dashboard.
 *
 * Channel order is his (2026-09-29): WhatsApp first because it is the one people
 * ask for, then the rest, with **phone call on by default** and text message
 * present because a responder may be unable to speak or hear.
 */
interface Props {
  action: string;
  contact?: ContactView | null;
  error?: string;
  submitLabel?: string;
  compact?: boolean;
}

const { action, contact = null, error = '', submitLabel = 'Save contact', compact = false } = Astro.props;

const CHANNEL_ORDER: Channel[] = ['whatsapp', 'signal', 'telegram', 'viber', 'call', 'sms'];
const selectedChannels = new Set(contact?.channels ?? ['call']);
const relationLabel = (relation: string) => MESSAGES.en[`relation.${relation}` as 'relation.spouse'];
const channelLabel = (channel: string) => MESSAGES.en[`channel.${channel}` as 'channel.call'];
const spokenLabel = (code: string) => MESSAGES.en[`spoken.${code}` as 'spoken.en'];
const selectedSpoken = new Set(contact?.spokenLanguages ?? []);
---

{error && <p class="error" role="alert">{error}</p>}

<form method="post" action={action} class={compact ? 'compact' : ''}>
  <div class="row">
    <div>
      <label for={`name-${contact?.id ?? 'new'}`}>Name</label>
      <input id={`name-${contact?.id ?? 'new'}`} name="name" type="text" required maxlength="80" value={contact?.name ?? ''} />
    </div>
    <div>
      <label for={`relation-${contact?.id ?? 'new'}`}>Relation</label>
      <select id={`relation-${contact?.id ?? 'new'}`} name="relation" required>
        {
          RELATIONS.map((relation) => (
            <option value={relation} selected={contact?.relation === relation}>
              {relationLabel(relation)}
            </option>
          ))
        }
      </select>
    </div>
  </div>

  <label for={`phone-${contact?.id ?? 'new'}`}>Phone</label>
  <input
    id={`phone-${contact?.id ?? 'new'}`}
    name="phone"
    type="tel"
    required
    autocomplete="tel"
    placeholder="+66 812 345 678"
    value={contact?.phoneDisplay ?? ''}
  />
  <p class="note">
    International format with a country code — <code>+66</code> for Thailand, <code>+36</code> for Hungary.
  </p>

  <fieldset>
    <legend>How can they be reached?</legend>
    <div class="channels">
      {
        CHANNEL_ORDER.map((channel) => (
          <label class="chip">
            <input type="checkbox" name="channels" value={channel} checked={selectedChannels.has(channel)} />
            <span>{channelLabel(channel)}</span>
          </label>
        ))
      }
    </div>
    <p class="note">
      A responder sees these as buttons or as a line of "available on". Text message matters: it is what
      works when someone cannot speak or hear.
    </p>
  </fieldset>

  <details>
    <summary>Languages this contact speaks</summary>
    <div class="chips">
      {
        SPOKEN_LANGUAGES.map((code) => (
          <label class="chip">
            <input type="checkbox" name="spoken" value={code} checked={selectedSpoken.has(code)} />
            <span>{spokenLabel(code)}</span>
          </label>
        ))
      }
    </div>
  </details>

  <button type="submit">{submitLabel}</button>
</form>

<style>
  input[type='text'],
  input[type='tel'],
  select {
    width: 100%;
    box-sizing: border-box;
    padding: 0.6rem 0.7rem;
    font: inherit;
    border: 1px solid #666;
    border-radius: 4px;
    background: #fff;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
  }
  .row > div {
    flex: 1 1 12rem;
  }
  fieldset {
    margin-top: 1rem;
    border: 1px solid #999;
    border-radius: 4px;
  }
  legend {
    font-weight: 600;
  }
  details {
    margin-top: 0.75rem;
  }
  summary {
    cursor: pointer;
    font-weight: 600;
  }
  .channels,
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 400;
    margin: 0;
  }
  .chip input {
    width: auto;
  }
</style>
