---
import Button from '@/components/Button.astro';

/**
 * A real modal for destructive actions, on the owner platform only (ADR-026).
 *
 * `<dialog>.showModal()` gives focus trapping, Escape, and an inert page behind it.
 * Everything still submits without JavaScript: the dialog is the confirmation, not
 * the mechanism.
 */
---

<dialog
  id="confirm-dialog"
  class="m-auto w-[min(30rem,calc(100vw-2rem))] rounded-lg border border-line bg-surface p-5 text-fg shadow-float backdrop:bg-black/55"
  aria-labelledby="confirm-title"
>
  <h2 id="confirm-title" class="text-base font-semibold" data-confirm-title>Are you sure?</h2>
  <p class="mt-2 text-sm leading-6 text-fg-muted" data-confirm-message></p>
  <div class="mt-5 flex justify-end gap-2">
    <Button variant="secondary" type="button" data-confirm-cancel>Cancel</Button>
    <Button variant="danger-solid" type="button" data-confirm-ok>Confirm</Button>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('confirm-dialog') as HTMLDialogElement | null;
  let pending: HTMLFormElement | null = null;

  if (dialog) {
    const title = dialog.querySelector('[data-confirm-title]') as HTMLElement;
    const message = dialog.querySelector('[data-confirm-message]') as HTMLElement;
    const ok = dialog.querySelector('[data-confirm-ok]') as HTMLButtonElement;
    const cancel = dialog.querySelector('[data-confirm-cancel]') as HTMLButtonElement;

    const open = (form: HTMLFormElement) => {
      pending = form;
      title.textContent = form.dataset.confirmTitle ?? 'Are you sure?';
      message.textContent = form.dataset.confirm ?? '';
      ok.textContent = form.dataset.confirmOk ?? 'Confirm';
      dialog.showModal();
    };

    for (const form of document.querySelectorAll<HTMLFormElement>('form[data-confirm]')) {
      form.addEventListener('submit', (event) => {
        // Second pass: the dialog already had its answer.
        if (form.dataset.confirmed === 'yes') return;
        event.preventDefault();
        open(form);
      });
    }

    ok.addEventListener('click', () => {
      if (!pending) return;
      pending.dataset.confirmed = 'yes';
      dialog.close();
      pending.requestSubmit();
    });

    cancel.addEventListener('click', () => {
      pending = null;
      dialog.close();
    });

    dialog.addEventListener('cancel', () => {
      pending = null;
    });
  }
</script>
