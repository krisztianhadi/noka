---
/**
 * The dashboard's client behaviour, in one component.
 *
 * It lives here rather than inline in the page because **Astro does not process a
 * `<script>` that arrives through a slot** — it is copied through unbundled and never
 * runs. The menu would not close once; the notes button would not disable another time.
 * Both were the same mistake, so all of the dashboard's behaviour lives in one place.
 */
---

<script>
  // 1. Menus close on an outside click and on Escape. A click inside stays inside.
  //    (Hiding a `<details>` does not clear its inputs, so a half-typed edit survives.)
  const menus = Array.from(document.querySelectorAll<HTMLDetailsElement>('details.menu, details.languages'));

  document.addEventListener('click', (event) => {
    const target = event.target as Node | null;
    for (const menu of menus) {
      if (menu.open && target && !menu.contains(target)) menu.open = false;
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    // An open modal owns Escape.
    if (document.querySelector('dialog[open]')) return;
    for (const menu of menus) menu.open = false;
  });

  // 2. Edit opens the contact's own form, in the page — never inside a dropdown panel.
  for (const trigger of document.querySelectorAll<HTMLButtonElement>('[data-edit-trigger]')) {
    trigger.addEventListener('click', () => {
      // A contact row is an <li>; the note card is neither, so the scope is either.
      const scope = trigger.closest('li, .editable');
      const form = scope?.querySelector<HTMLDetailsElement>('details.edit-form');
      if (!form) return;
      // The trigger is a menu item now, so close the menu behind it: the form opens in the
      // page below the contact, and a panel floating over it would be in the way.
      trigger.closest('details')?.removeAttribute('open');
      form.open = true;
      form.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      // Focus the first field of whatever form was revealed: a name, or the note itself.
      form
        .querySelector<HTMLInputElement | HTMLTextAreaElement>('input[name="name"], textarea')
        ?.focus();
    });
  }

  // 3. Cancel closes the disclosure its form lives in and clears what was typed.
  //    The link's href is the no-JavaScript fallback.
  for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-cancel]')) {
    link.addEventListener('click', (event) => {
      const details = link.closest('details');
      const form = link.closest('form');
      if (!details || !form) return;
      event.preventDefault();
      form.reset();
      details.open = false;
    });
  }

  // 4. "Save notes" is meaningless until something changed — but only in the notes-only form.
  //    The first-run form also carries a note, and its button saves the contact too, so
  //    disabling it there left a new owner unable to save anything at all.
  const notes = document.getElementById('notes') as HTMLTextAreaElement | null;
  const saveNotes = notes
    ?.closest('form[action="/dashboard/notes"]')
    ?.querySelector<HTMLButtonElement>('button[type="submit"]');
  if (notes && saveNotes) {
    const initial = notes.value;
    const sync = () => {
      saveNotes.disabled = notes.value === initial;
    };
    notes.addEventListener('input', sync);
    sync();
  }

  // 5. Space a phone number as it is typed, and never eat a deliberate "+": a value that
  //    starts with one is already international and is sent as typed.
  for (const input of document.querySelectorAll<HTMLInputElement>('input[data-phone]')) {
    input.addEventListener('input', () => {
      const international = input.value.trimStart().startsWith('+');
      const digits = input.value.replace(/[^\d]/g, '').slice(0, 15);
      input.value = `${international ? '+' : ''}${digits.replace(/(\d{3})(?=\d)/g, '$1 ').trim()}`;
    });
  }
</script>
