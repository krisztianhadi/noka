---
import Icon from '@/components/Icon.astro';
import { t } from '@/i18n/catalogue';
import { brandIcon } from '@/lib/brand-icons';
import { LANGUAGE_INFO, type CardLanguage } from '@/i18n/languages';

/**
 * The owner-plane footer: who made this, the legal links, and the language choice.
 *
 * It is deliberately **not** on the responder plane. `/c/*` is a page a stranger opens
 * once in an emergency: it shows the people to call and nothing else — no maker, no
 * marketing, no links away from the card (ADR-026).
 *
 * Same shape as the sibling project's footer (made-by line, legal nav), expressed in this
 * project's tokens. The language switcher lives here because it is the one setting that
 * belongs to every owner page — including the ones before signing in, where a person who
 * cannot read English needs it most.
 */
const locale = Astro.locals.locale;
const label = (key: Parameters<typeof t>[1]) => t(locale, key);
const languages = Object.keys(LANGUAGE_INFO) as CardLanguage[];
// Back to the page the choice was made on, so switching does not move anyone.
const next = Astro.url.pathname + Astro.url.search;
// One sentence with a placeholder, so a translator puts the studio wherever their
// language wants it instead of inheriting English word order.
const madeBy = label('footer.madeBy').split('{studio}');
---

<footer class="mt-12 border-t border-line pt-5 pb-10">
  <div class="flex flex-col items-center gap-3 text-xs text-fg-muted sm:flex-row sm:justify-between">
    <p class="flex flex-wrap items-center justify-center gap-1.5">
      {madeBy[0]}<a
        class="whitespace-nowrap text-fg underline underline-offset-2"
        href="https://lostsignals.studio">Lost Signals Studio</a>{madeBy[1]}
    </p>
    <nav
      aria-label={label('footer.legal')}
      class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1"
    >
      <a class="whitespace-nowrap hover:text-fg" href="/privacy">{label('footer.privacy')}</a>
      <a class="whitespace-nowrap hover:text-fg" href="/terms">{label('footer.terms')}</a>
      <a class="whitespace-nowrap hover:text-fg" href="/imprint">{label('footer.imprint')}</a>
      <a
        class="inline-flex items-center gap-1.5 whitespace-nowrap hover:text-fg"
        href="https://github.com/krisztianhadi/noka"
      >
        <svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true" focusable="false" class="shrink-0">
          <path d={brandIcon('github')?.path} fill="currentColor" />
        </svg>
        {label('footer.source')}
      </a>

      <details class="languages relative">
        <summary
          class="flex cursor-pointer list-none items-center gap-1.5 whitespace-nowrap rounded-md border border-line bg-surface px-2 py-1 marker:content-none hover:bg-muted hover:text-fg"
        >
          <Icon name="globe" size={12} />
          {LANGUAGE_INFO[locale].endonym}
          <Icon name="chevron" size={12} class="opacity-70" />
        </summary>
        <!-- Opens upwards: a footer sits at the bottom of the page, so a downward panel
             either runs off the viewport or makes the page scroll to reach it. -->
        <form
          method="post"
          action="/language"
          class="panel absolute right-0 bottom-full z-20 mb-1 min-w-44 rounded-lg border border-line bg-surface p-1 shadow-float"
        >
          <input type="hidden" name="next" value={next} />
          {
            languages.map((code) => (
              <button
                class="menu-item flex w-full items-center gap-2 rounded-md px-2.5 py-2 text-left text-sm text-fg no-underline hover:bg-muted"
                type="submit"
                name="lang"
                value={code}
                aria-current={code === locale}
              >
                {LANGUAGE_INFO[code].endonym}
              </button>
            ))
          }
        </form>
      </details>
    </nav>
  </div>
</footer>
