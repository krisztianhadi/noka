---
import Icon from '@/components/Icon.astro';

/**
 * The owner-plane footer: who made this, and where the legal text lives.
 *
 * It is deliberately **not** on the responder plane. `/c/*` is a page a stranger opens
 * once in an emergency: it shows the people to call and nothing else — no maker, no
 * marketing, no links away from the card (ADR-026).
 *
 * Same shape as the sibling project's footer (made-by line, legal nav), expressed in this
 * project's tokens.
 */
---

<footer class="mt-12 border-t border-line pt-5">
  <div class="flex flex-col items-center gap-3 text-xs text-fg-muted sm:flex-row sm:justify-between">
    <p class="flex flex-wrap items-center justify-center gap-1.5">
      Made with
      <span class="text-danger" aria-hidden="true">♥</span>
      by
      <a class="whitespace-nowrap text-fg underline underline-offset-2" href="https://lostsignals.studio">Lost Signals Studio</a>
    </p>
    <nav aria-label="Legal" class="flex flex-wrap justify-center gap-x-4 gap-y-1">
      <a class="whitespace-nowrap hover:text-fg" href="/privacy">Privacy</a>
      <a class="whitespace-nowrap hover:text-fg" href="/terms">Terms</a>
      <a class="whitespace-nowrap hover:text-fg" href="/imprint">Imprint</a>
      <a class="inline-flex items-center gap-1 hover:text-fg" href="https://github.com/krisztianhadi/noka">
        <Icon name="link" size={12} /> Source
      </a>
    </nav>
  </div>
</footer>
