---
/**
 * Menu dismissal for the owner plane.
 *
 * `<details>` has no notion of clicking away, so a kebab or the account menu stays
 * open over the page until it is clicked again. This closes any open menu on an
 * outside click and on Escape, while a click *inside* a menu keeps it open.
 *
 * Hiding a `<details>` does not clear its inputs, so anything typed into the edit
 * form is still there when it is reopened.
 *
 * The add-contact disclosure is deliberately not part of this: it is a work surface
 * with a form in it, not a menu, and it should not vanish while it is being read.
 *
 * A component rather than an inline script in the page, because Astro does not
 * process `<script>` tags that arrive through a slot — this was silently dropped
 * when it lived in `dashboard/index.astro`.
 */
---

<script>
  const menus = Array.from(document.querySelectorAll<HTMLDetailsElement>('details.menu'));

  document.addEventListener('click', (event) => {
    const target = event.target as Node | null;
    for (const menu of menus) {
      if (menu.open && target && !menu.contains(target)) menu.open = false;
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    // An open modal owns Escape.
    if (document.querySelector('dialog[open]')) return;
    for (const menu of menus) menu.open = false;
  });
</script>
