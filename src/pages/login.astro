---
import Button from '@/components/Button.astro';
import Plain from '@/layouts/Plain.astro';
import { getAuth } from '@/lib/auth';
import { noticeMessage } from '@/lib/dashboard';
import { errorMessage, field, forbidden, isSameOrigin, readForm, redirectWithCookies } from '@/lib/http';

let error = '';
// A password change redirects here, so the reason for the sign-out is on the page.
const notice = noticeMessage(Astro.url.searchParams.get('notice'));
let email = '';

if (Astro.request.method === 'POST') {
  if (!isSameOrigin(Astro.request)) return forbidden();

  const form = await readForm(Astro.request);
  if (!form) return forbidden();
  email = field(form, 'email');
  const password = field(form, 'password');

  const response = await getAuth().api.signInEmail({
    body: { email, password },
    asResponse: true,
  });

  if (response.ok) return redirectWithCookies('/dashboard', response);
  // One message for every failure: no account-existence oracle (§6 layer 0).
  error = (await errorMessage(response, '')) || 'That email and password do not match.';
}
---

<Plain title="Sign in to noka">
  <h1 class="text-xl font-semibold tracking-tight">Sign in</h1>

  {
    notice && (
      <p class="notice mt-4 rounded-md border px-3 py-2 text-sm border-success/40 bg-success/10 text-success" role="status">{notice}</p>
    )
  }
  {
    error && (
      <p class="error mt-4 rounded-md border px-3 py-2 text-sm border-danger/40 bg-danger/10 text-danger" role="alert">{error}</p>
    )
  }

  <form method="post" class="mt-6 space-y-4 rounded-lg border border-line bg-surface p-4 sm:p-5">
    <div>
      <label class="mb-1.5 block text-sm font-medium text-fg" for="email">Email</label>
      <input id="email" class="h-10 w-full rounded-md border border-line-strong bg-surface px-3 text-sm text-fg outline-none" name="email" type="email" required autocomplete="email" value={email} />
    </div>

    <div>
      <label class="mb-1.5 block text-sm font-medium text-fg" for="password">Password</label>
      <input id="password" class="h-10 w-full rounded-md border border-line-strong bg-surface px-3 text-sm text-fg outline-none" name="password" type="password" required autocomplete="current-password" />
    </div>

    <div class="flex justify-end">
      <Button type="submit">Sign in</Button>
    </div>
  </form>

  <p class="mt-4 text-sm text-fg-muted">No account yet? <a class="text-fg" href="/signup">Create one</a></p>
</Plain>
