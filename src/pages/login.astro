---
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import Plain from '@/layouts/Plain.astro';
import SponsorStrip from '@/components/SponsorStrip.astro';
import { getAuth } from '@/lib/auth';
import { getConfig } from '@/config';
import { t } from '@/i18n/catalogue';
import { errorKey as errorKeyFor, noticeKey } from '@/lib/dashboard';
import { errorMessage, field, forbidden, isSameOrigin, readForm, redirectWithCookies } from '@/lib/http';

const locale = Astro.locals.locale;
const label = (key: Parameters<typeof t>[1], values?: Record<string, string | number>) =>
  t(locale, key, values);

// Errors in this block are message **keys**; they are translated once, at render.
let errorKey: Parameters<typeof t>[1] | null = null;
// A password change redirects here, so the reason for the sign-out is on the page.
const notice = noticeKey(Astro.url.searchParams.get('notice'));
// A failed OAuth callback comes back as a query parameter, not a POST error.
const oauthError = errorKeyFor(Astro.url.searchParams.get('error'));
// Google sign-in exists only when this instance has a client for it (2026-10-05): an OAuth button
// that cannot work is worse than no button.
const googleSignIn = Boolean(getConfig().GOOGLE_CLIENT_ID);
let email = '';

if (Astro.request.method === 'POST') {
  if (!isSameOrigin(Astro.request)) return forbidden();

  const form = await readForm(Astro.request);
  if (!form) return forbidden();
  email = field(form, 'email');
  const password = field(form, 'password');

  const response = await getAuth().api.signInEmail({
    body: { email, password },
    asResponse: true,
  });

  if (response.ok) return redirectWithCookies('/dashboard', response);
  // One message for every failure: no account-existence oracle (§6 layer 0).
  void (await errorMessage(response, ''));
  errorKey = 'error.credentials';
}
---

<Plain title={label('head.login')}>
  <h1 class="text-xl font-semibold tracking-tight">{label('auth.login.title')}</h1>

  {
    notice && (
      <p class="notice mt-4 rounded-md border px-3 py-2 text-sm border-success/40 bg-success/10 text-success" role="status">
        {label(notice)}
      </p>
    )
  }
  {
    (errorKey || oauthError) && (
      <p class="error mt-4 rounded-md border px-3 py-2 text-sm border-danger/40 bg-danger/10 text-danger" role="alert">
        {label(errorKey ?? oauthError!)}
      </p>
    )
  }

  <form method="post" class="mt-6 space-y-4 rounded-lg border border-line bg-surface p-4 sm:p-5">
    <div>
      <label class="mb-1.5 block text-sm font-medium text-fg" for="email">{label('auth.login.email')}</label>
      <input id="email" class="h-10 w-full rounded-md border border-line-strong bg-surface px-3 text-sm text-fg outline-none" name="email" type="email" required autocomplete="email" value={email} />
    </div>

    <div>
      <label class="mb-1.5 block text-sm font-medium text-fg" for="password">{label('auth.login.password')}</label>
      <input id="password" class="h-10 w-full rounded-md border border-line-strong bg-surface px-3 text-sm text-fg outline-none" name="password" type="password" required autocomplete="current-password" />
    </div>

    <div class="flex items-center justify-between gap-3">
      <a class="text-sm text-fg-muted underline underline-offset-2" href="/forgot">{label('auth.forgot.link')}</a>
      <Button type="submit"><Icon name="login" size={16} /> {label('auth.login.submit')}</Button>
    </div>
  </form>

  {
    googleSignIn && (
      <form method="post" action="/auth/google" class="mt-4">
        <Button variant="secondary" type="submit" class="w-full">
          <Icon name="globe" size={16} /> {label('auth.google')}
        </Button>
      </form>
    )
  }

  <p class="mt-4 text-sm text-fg-muted">
    {label('auth.login.need')} <a class="text-fg" href="/signup">{label('auth.signup.link')}</a>
  </p>

  <SponsorStrip />
</Plain>
