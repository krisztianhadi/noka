---
import Footer from '@/components/Footer.astro';
import Icon from '@/components/Icon.astro';
import { LANGUAGE_INFO } from '@/i18n/languages';
import { brandIcon } from '@/lib/brand-icons';
import '@/styles/app.css';
// Inlined, not an `<img>`: the wordmark is drawn with `currentColor`, and as an external
// image that resolves to the SVG's own default (black) — invisible on a dark page.
import wordmark from '../../assets/brand/noka-wordmark.svg?raw';
import cardShot from '../../assets/brand/noka-card-sample.jpg';

/**
 * The landing page: the owner plane's front door, and the only surface in the product
 * allowed to have a mood.
 *
 * The responder plane's rules — no JavaScript, no outside anything, tiny and instant —
 * apply to `/c/*`, where a stranger is in a hurry on a bad connection. They were never
 * meant for here, and applying them here is what produced a wireframe: this page may use
 * fonts, texture, motion and colour, and it should.
 *
 * Structure follows the sibling project's rhythm: hero, what this is, what we are not
 * doing, how it works, questions, one closing action. The honesty is the design.
 *
 * Copy is English-only for now, inline rather than in the catalogue: the wording waits on
 * his read, and translating a draft into four more languages is work thrown away if a
 * headline changes (ADR-032).
 */
const locale = Astro.locals.locale;
// Deleting an account lands here, so the page has to say it happened.
const deleted = Astro.url.searchParams.get('deleted') === '1';

const eyebrow = 'font-mono text-[0.7rem] tracking-[0.18em] text-fg-muted uppercase';
const h2 = 'mt-3 text-2xl font-semibold tracking-tight text-balance sm:text-3xl';

const features = [
  {
    icon: 'phone' as const,
    title: 'Tap to call',
    body: 'The page shows the contacts you chose, with buttons that dial them. It works on a smartphone with an internet connection.',
  },
  {
    icon: 'lock' as const,
    title: 'Kept private',
    body: 'Your contacts and note are heavily encrypted to protect them — before they are ever stored.',
  },
  {
    icon: 'globe' as const,
    title: 'More languages coming',
    body: 'English, Spanish, French, Simplified Chinese and Russian today, with more to come. You choose which languages are printed on your card.',
  },
  {
    icon: 'eye-off' as const,
    title: 'No tracking on the card page',
    body: 'Nothing is loaded from anywhere else, and no record is kept that somebody looked.',
  },
  {
    icon: 'bars' as const,
    title: 'Kept small for slow connections',
    body: 'The card page is stripped back to the minimum that is technically possible, so it should work on the slowest mobile internet. It does need a connection.',
  },
];

const everyday = [
  {
    icon: 'card' as const,
    title: 'Lost wallet or bag',
    body: 'Keep it in a wallet, bag, phone case or passport holder. Whoever finds it can call a person you chose.',
  },
  {
    icon: 'refresh' as const,
    title: 'When a contact changes their number',
    body: 'Edit a contact once, and every card you have already printed shows the new number the next time it is opened.',
  },
  {
    icon: 'edit' as const,
    title: 'A short note from you',
    body: 'The page shows the short note and the contacts you chose to share — nothing more.',
  },
];

const notDoing = [
  {
    icon: 'x' as const,
    title: 'Noka is not an emergency service',
    body: 'Call the local emergency number first. The card is for reaching the people you would want told afterwards.',
  },
  {
    icon: 'x' as const,
    title: 'Noka is not a medical record',
    body: 'It has no fields for diagnoses, medication doses or allergies. It shows the short note you write.',
  },
  {
    icon: 'lock' as const,
    title: 'Noka does not hide the card from whoever holds it',
    body: 'Anyone with the card and its PIN can read the contacts and the note. That is what lets a stranger help without installing an app or making an account.',
  },
  {
    icon: 'eye-off' as const,
    title: 'Noka does not track the person who opens it',
    body: 'No app to install, no account to create, and no tracking of whoever opens the page.',
  },
];

const steps = [
  {
    icon: 'edit' as const,
    title: 'Set it up',
    body: 'Add your contacts and one short note. Choose which languages are printed on the card.',
  },
  {
    icon: 'print' as const,
    title: 'Print it yourself',
    body: 'Print the card and keep it with you. It holds a QR code and a six-digit PIN.',
  },
  {
    icon: 'phone' as const,
    title: 'Someone scans it',
    body: 'The person helping you scans the QR code, enters the PIN and sees your contacts and note. They tap a name to call. An internet connection is needed.',
  },
];

const faq = [
  {
    q: 'Is this an emergency service?',
    a: 'No. Call the local emergency number first. Noka can give whoever is helping you useful contacts and a note, but it does not replace emergency services.',
  },
  {
    q: 'What if someone steals the card?',
    a: 'Anyone with the card and its PIN can read the contacts and note. That is the trade-off that lets a stranger help without an app or account.',
  },
  {
    q: 'Is this my medical record?',
    a: 'No. Noka is not a medical record and has no fields for diagnoses, medication doses or allergies. It shows the short note you write.',
  },
  {
    q: 'Does the card work without a signal?',
    a: 'It needs an internet connection. The card page is stripped back to the minimum that is technically possible, so it should still open on the slowest mobile internet — but with no connection at all, there is no page.',
  },
  {
    q: 'Are you tracking the person who opens it?',
    a: "The card page keeps no record that somebody looked, and there is no analytics. To slow down repeated guesses at the PIN, it keeps a scrambled, one-way version of the visitor's rough network location — never their actual address — and deletes that after 30 days.",
  },
  {
    q: 'Can I order a plastic or metal card?',
    a: 'No. Noka does not print or send cards. You print the card yourself, so there is nothing to order, ship or renew.',
  },
  {
    q: 'Will I be charged later?',
    a: 'Noka is free to use, and there are no paid tiers, trials or charges.',
  },
  {
    q: 'Which languages are supported?',
    a: 'English, Spanish, French, Simplified Chinese and Russian are available now, with more to come. You choose which languages are printed on your card, and the page also opens in whichever of them the visitor\'s phone is set to.',
  },
  {
    q: 'What if I just lose my wallet?',
    a: 'The card is for that too. Whoever finds your wallet, bag, phone or keys can contact the people you listed, without your phone, your password or an app. Keep it wherever you keep your things.',
  },
  {
    q: 'My brother changed his number. Do I need a new card?',
    a: 'No. Edit the contact and every card you have already printed shows the new number the next time it is opened.',
  },
];

// The primary action wears the post-it colour, the same one the closing banner uses: the page
// has exactly one loud colour and it should mean "this is the thing to press".
const buttonPrimary =
  'inline-flex h-11 items-center justify-center gap-2 rounded-full border border-mark bg-mark px-5 text-sm font-semibold text-mark-fg no-underline shadow-card transition hover:-translate-y-px hover:brightness-[1.03]';
// Same call to action, same colour, whether it sits on the ink hero or the light page.
const buttonOnInk =
  'inline-flex h-11 items-center justify-center gap-2 rounded-full border border-mark bg-mark px-5 text-sm font-semibold text-mark-fg no-underline transition hover:-translate-y-px hover:brightness-[1.03]';
// On the mustard panel the mustard button would vanish into its own background, so the call to
// action there is ink on post-it.
const buttonOnMark =
  'inline-flex h-11 items-center justify-center gap-2 rounded-full border border-ink bg-ink px-5 text-sm font-semibold text-ink-fg no-underline shadow-card transition hover:-translate-y-px hover:opacity-90';
const buttonGhostOnInk =
  'inline-flex h-11 items-center justify-center gap-2 rounded-full border border-white/30 px-5 text-sm font-medium text-ink-fg no-underline transition hover:border-white/60 hover:bg-white/10';
---

<!doctype html>
<html lang={LANGUAGE_INFO[locale].htmlLang} data-theme={Astro.locals.theme ?? undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>noka — a note in your wallet, made easier to find</title>
    <meta
      name="description"
      content="A card the size of a bank card, with a QR code and a six-digit PIN. Whoever finds you or your belongings can see who to call, plus a short note from you."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body class="min-h-dvh">
    <header class="sticky top-0 z-30 border-b border-line bg-surface">
      <div class="mx-auto flex w-full max-w-5xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
        <a class="w-20 text-fg [&_svg]:h-auto [&_svg]:w-full" href="/" aria-label="noka" set:html={wordmark} />
        <nav class="hidden items-center gap-6 text-sm sm:flex" aria-label="Sections">
          <a class="text-fg-muted no-underline transition hover:text-fg" href="#what">What it is</a>
          <a class="text-fg-muted no-underline transition hover:text-fg" href="#limits">Limits</a>
          <a class="text-fg-muted no-underline transition hover:text-fg" href="#how">How it works</a>
          <a class="text-fg-muted no-underline transition hover:text-fg" href="#questions">Questions</a>
        </nav>
        <div class="flex items-center gap-2">
          <a class="hidden text-sm font-medium text-fg no-underline sm:inline" href="/login">Sign in</a>
          <a class={`${buttonPrimary} h-9 px-4`} href="/signup">Create an account</a>
        </div>
      </div>
    </header>

    <main class="w-full">
      {
        deleted && (
          <p
            class="border-b border-success/40 bg-success/10 px-4 py-3 text-center text-sm text-success sm:px-6"
            role="status"
          >
            Your account and everything in it has been deleted.
          </p>
        )
      }

    <!-- Hero: the one loud surface in the product. Ink panel, dot texture, and the card. -->
    <section class="relative overflow-hidden bg-ink text-ink-fg">
      <div
        class="pointer-events-none absolute inset-0 opacity-[0.14]"
        style="background-image: radial-gradient(currentColor 1px, transparent 1px); background-size: 22px 22px"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute -top-32 -right-20 hidden size-[26rem] rounded-full opacity-[0.18] blur-[80px] sm:block"
        style="background: radial-gradient(closest-side, var(--noka-mark), transparent)"
        aria-hidden="true"
      >
      </div>

      <div class="relative mx-auto w-full max-w-5xl px-4 py-14 sm:px-6 sm:py-20">
        <div class="items-center gap-12 sm:grid sm:grid-cols-[1.1fr_0.9fr]">
          <div class="reveal">
            <p class="font-mono text-[0.7rem] tracking-[0.2em] text-ink-fg/60 uppercase">
              Emergency contact card
            </p>
            <h1
              class="mt-5 text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-5xl lg:text-6xl"
            >
              Help someone reach the people you trust.
            </h1>
            <p class="mt-6 max-w-xl text-base leading-7 text-ink-fg/75 sm:text-lg">
              A card the size of a bank card, with a QR code and a six-digit PIN. Whoever finds you or your
              belongings scans it, enters the PIN and sees who to call — plus a short note from you. You print
              it yourself.
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-3">
              <a class={buttonOnInk} href="/signup">Create an account</a>
              <a class={buttonGhostOnInk} href="#how">See how it works <Icon name="arrow-right" size={16} /></a>
            </div>

          </div>

          <!-- The product is a thing you hold, so on mobile it comes before any prose. -->
          <figure class="reveal mt-10 sm:mt-0">
            <div class="group relative mx-auto w-[68%] max-w-[19rem] sm:w-full sm:max-w-none">
              <div
                class="absolute inset-0 translate-y-3 rounded-2xl bg-black/40 blur-2xl"
                aria-hidden="true"
              >
              </div>
              <img
                class="relative w-full rotate-[-1.5deg] rounded-2xl shadow-2xl transition duration-500 group-hover:rotate-0 group-hover:scale-[1.02]"
                src={cardShot.src}
                width="638"
                height="1011"
                alt="The noka card: a five-language heading, a QR code and a six-digit PIN"
              />
            </div>
            <figcaption class="mx-auto mt-6 max-w-xs text-center text-xs leading-5 text-ink-fg/60">
              <span class="block">
                You print this yourself, on a standard printer, at bank-card size.
              </span>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

      <div class="mx-auto w-full max-w-5xl px-4 sm:px-6">
      <!-- What this is -->
      <section id="what" class="reveal scroll-mt-24 py-16 sm:py-24">
        <p class={eyebrow}>What this is</p>
        <h2 class={h2}>A simple way to share who to call.</h2>
        <p class="mt-5 max-w-2xl text-base leading-7 text-fg-muted">
          Add the people to call, write one short note and choose which languages are printed on the card.
          If a contact's number changes, update it here: cards you have already printed show the new number
          the next time they are opened.
        </p>

        <div class="mt-10 grid gap-4 sm:grid-cols-2">
          {
            features.map((feature) => (
              <div class="group rounded-2xl border border-line-strong bg-surface p-6 shadow-card transition hover:-translate-y-0.5">
                <span class="inline-flex size-10 items-center justify-center rounded-xl bg-muted text-fg">
                  <Icon name={feature.icon} size={18} />
                </span>
                <h3 class="mt-4 text-base font-semibold text-fg">{feature.title}</h3>
                <p class="mt-1.5 text-sm leading-6 text-fg-muted">{feature.body}</p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- The everyday case: most cards never meet an emergency. -->
      <section class="reveal pb-16 sm:pb-24">
        <p class={eyebrow}>Where it helps</p>
        <h2 class={h2}>Useful in everyday situations too.</h2>
        <p class="mt-5 max-w-2xl text-base leading-7 text-fg-muted">
          It is not only for accidents. Leave a wallet on a bus, send a bag to the wrong carousel, hand in a
          phone at a hotel desk — whoever finds your things can reach someone you trust, without unlocking
          anything of yours.
        </p>
        <div class="mt-8 grid gap-4 sm:grid-cols-3">
          {
            everyday.map((item) => (
              <div class="rounded-2xl border border-line-strong bg-surface p-5 shadow-card">
                <span class="inline-flex size-9 items-center justify-center rounded-xl bg-muted text-fg">
                  <Icon name={item.icon} size={17} />
                </span>
                <h3 class="mt-3 text-sm font-semibold text-fg">{item.title}</h3>
                <p class="mt-1.5 text-sm leading-6 text-fg-muted">{item.body}</p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- What we are not doing: the page's character, so it gets its own weight — a full-width
           band rather than another card, and no highlight box inside it. -->
      <section
        id="limits"
        class="reveal relative -mx-4 scroll-mt-24 overflow-hidden border-y border-line bg-ink text-ink-fg sm:-mx-6"
      >
        <div
          class="pointer-events-none absolute inset-0 opacity-[0.12]"
          style="background-image: radial-gradient(currentColor 1px, transparent 1px); background-size: 22px 22px"
          aria-hidden="true"
        >
        </div>
        <div class="relative mx-auto w-full max-w-5xl px-4 py-16 sm:px-6 sm:py-24">
          <p class="font-mono text-[0.7rem] tracking-[0.18em] text-ink-fg/60 uppercase">
            What noka does not do
          </p>
          <h2 class="mt-3 text-2xl font-semibold tracking-tight text-balance sm:text-3xl">
            This is a small tool. Its limits are part of the design.
          </h2>
          <dl class="mt-10 grid gap-x-12 gap-y-8 sm:grid-cols-2">
            {
              notDoing.map((limit) => (
                <div class="border-t border-white/15 pt-5">
                  <dt class="flex items-center gap-2.5 text-base font-semibold text-ink-fg">
                    <span class="text-ink-fg/60">
                      <Icon name={limit.icon} size={17} />
                    </span>
                    {limit.title}
                  </dt>
                  <dd class="mt-2 text-sm leading-6 text-ink-fg/70">{limit.body}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </section>

      <!-- How it works: three steps on one line, connected, so they read as a sequence rather
           than three unrelated cards. -->
      <section id="how" class="reveal scroll-mt-24 py-16 sm:py-24">
        <p class={eyebrow}>How it works</p>
        <h2 class={h2}>Three simple steps.</h2>
        <ol class="mt-12 space-y-8 sm:grid sm:grid-cols-3 sm:gap-8 sm:space-y-0">
          {
            steps.map((step, index) => (
              <li class="relative pl-16 sm:pl-0 sm:pt-14">
                <span
                  class="absolute top-0 left-0 flex size-11 items-center justify-center rounded-full border border-line-strong bg-surface font-mono text-sm font-semibold text-fg shadow-card"
                  aria-hidden="true"
                >
                  {index + 1}
                </span>
                {/* The rule runs from this node to the next one, and stops at the last: a line
                    trailing off the end of a sequence reads as a mistake. */}
                {index < steps.length - 1 && (
                  <span
                    class="absolute top-[1.375rem] left-14 hidden h-px w-[calc(100%-2rem)] bg-line-strong sm:block"
                    aria-hidden="true"
                  />
                )}
                {index < steps.length - 1 && (
                  <span
                    class="absolute top-12 left-[1.375rem] h-[calc(100%-2.5rem)] w-px bg-line-strong sm:hidden"
                    aria-hidden="true"
                  />
                )}
                <h3 class="flex items-center gap-2 text-base font-semibold text-fg">
                  <span class="text-fg-muted"><Icon name={step.icon} size={16} /></span>
                  {step.title}
                </h3>
                <p class="mt-1.5 text-sm leading-6 text-fg-muted">{step.body}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <!-- Privacy and ownership -->
      <section
        class="reveal rounded-3xl border border-line-strong bg-ink p-6 text-ink-fg shadow-card sm:flex sm:items-center sm:gap-10 sm:p-10"
      >
        <div class="sm:flex-1">
          <p class="flex items-center gap-2 font-mono text-[0.7rem] tracking-[0.18em] text-ink-fg/60 uppercase">
            <Icon name="lock" size={13} /> Privacy and ownership
          </p>
          <h2 class="mt-3 text-xl font-semibold tracking-tight text-balance sm:text-2xl">
            Your details are protected. The code is open to inspect.
          </h2>
          <p class="mt-4 text-sm leading-6 text-ink-fg/75">
            Your contacts and note are heavily encrypted to protect your data. Anything that is kept about
            who opened a card holds no real IP address, and is deleted after 30 days.
          </p>
          <details class="group mt-4">
            <summary class="inline-flex cursor-pointer list-none items-center gap-1.5 font-mono text-[0.7rem] tracking-wider text-ink-fg/70 uppercase marker:content-none hover:text-ink-fg">
              Technical details
              <span class="transition group-open:rotate-45"><Icon name="plus" size={12} /></span>
            </summary>
            <ul class="mt-3 space-y-1 font-mono text-[0.7rem] leading-5 text-ink-fg/70">
              <li>AES-256-GCM encryption, with a versioned key that never leaves the application</li>
              <li>Passwords and PINs hashed with Argon2id — 19 MiB, two passes — per RFC 9106</li>
              <li>Network prefixes as HMAC-SHA-256, never a raw address; deleted after 30 days</li>
              <li>Served over HTTPS with HSTS and a content policy that allows no outside resource</li>
            </ul>
          </details>
        </div>
        <div class="mt-6 sm:mt-0 sm:text-right">
          <a
            class="inline-flex items-center gap-2 rounded-full border border-white/25 px-4 py-2 text-sm no-underline text-ink-fg transition hover:border-white/60 hover:bg-white/10"
            href="https://github.com/krisztianhadi/noka"
          >
            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false" class="shrink-0">
              <path d={brandIcon('github')?.path} fill="currentColor" />
            </svg>
            Read the code on GitHub
          </a>
          <p class="mt-2 font-mono text-[0.65rem] tracking-wider text-ink-fg/50 uppercase">
            MIT licensed · developed in the open
          </p>
        </div>
      </section>

      <!-- Questions -->
      <section id="questions" class="reveal scroll-mt-24 py-16 sm:py-24">
        <p class={eyebrow}>Questions, answered</p>
        <h2 class={h2}>Common questions</h2>
        <div class="mt-8 grid gap-3 sm:grid-cols-2">
          {
            faq.map((item) => (
              <details class="group rounded-2xl border border-line bg-surface px-5 py-4 transition open:border-line-strong hover:border-line-strong">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium text-fg marker:content-none">
                  {item.q}
                  <span class="shrink-0 text-fg-muted transition group-open:rotate-45">
                    <Icon name="plus" size={16} />
                  </span>
                </summary>
                <p class="mt-3 text-sm leading-6 text-fg-muted">{item.a}</p>
              </details>
            ))
          }
        </div>
      </section>

      <!-- Closing action, on a post-it. -->
      <section class="reveal pb-16 sm:pb-24">
        <div
          class="relative mx-auto max-w-2xl rotate-[-0.6deg] rounded-3xl bg-mark p-8 text-center text-mark-fg shadow-float sm:p-12"
        >
          <h2 class="text-2xl font-semibold tracking-tight text-balance sm:text-3xl">
            Create your card and print it yourself.
          </h2>
          <p class="mx-auto mt-4 max-w-md text-sm leading-6 text-mark-fg/80">
            Add your contacts, write a short note, then print the bank-card-sized card on your own printer.
          </p>
          <div class="mt-7">
            <a class={`${buttonOnMark} w-full sm:w-auto`} href="/signup">Create an account</a>
          </div>
          <p class="mt-4 font-mono text-[0.65rem] tracking-wider text-mark-fg/70 uppercase">
            Free to use · No paid tiers · No trial
          </p>
        </div>
      </section>

      <Footer />
      </div>
    </main>

    <script>
      // Reveal on scroll, and nothing else: no tracking, no third party, and it degrades to
      // "everything is visible" when the observer is missing or motion is not wanted.
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = document.querySelectorAll<HTMLElement>('.reveal');
      if (reduce || !('IntersectionObserver' in window)) {
        for (const target of targets) target.dataset.shown = 'true';
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                (entry.target as HTMLElement).dataset.shown = 'true';
                observer.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px' },
        );
        for (const target of targets) observer.observe(target);
      }
    </script>

    <style>
      /* Landing-only polish, kept here rather than in the app scale: the dashboard has no use
         for a reveal animation, and the tokens above are the parts worth sharing. */
      .reveal {
        /* Movement only, no fade: colour contrast is not affected by a transform, so the
           content stays legible to axe — and to anyone reading before the animation
           settles. */
        translate: 0 10px;
        transition: translate 0.5s ease;
      }
      .reveal[data-shown='true'] {
        translate: 0;
      }
      @media (prefers-reduced-motion: reduce) {
        .reveal {
          translate: none;
          transition: none;
        }
      }
    </style>
  </body>
</html>
