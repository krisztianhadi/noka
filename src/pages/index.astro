---
import Icon from '@/components/Icon.astro';

// Landing page. Functionality first: no design pass yet, no tracking, no scripts.
// Icons and the wordmark are allowed here (the card page is the one that stays bare).
// Sponsor logos (D18) and the auth links land with their phases.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>noka — emergency contacts in your wallet</title>
    <meta
      name="description"
      content="A printed card with a QR code and a PIN. Anyone who finds it can reach your emergency contacts in seconds."
    />
    <link rel="icon" href="data:," />
  </head>
  <body>
    <main>
      <h1>
        <img src="/noka-wordmark.svg" alt="noka" width="210" height="77" />
      </h1>
      <p><em>next of kin access</em></p>

      <p>
        A card the size of a bank card, carrying a QR code and a six-digit PIN. Someone helping you scans it,
        enters the PIN, and sees the people to call — with tap-to-call buttons — in under a second, on any
        phone, without JavaScript and without an app.
      </p>

      <ul class="points">
        <li><Icon name="lock" /> Your contacts are encrypted; the key is not in the database.</li>
        <li><Icon name="signal" /> The page works on a bad mobile connection and asks for nothing.</li>
        <li><Icon name="eye-off" /> No tracking on the card page, and no data sold, ever.</li>
      </ul>

      <p><a href="/signup">Create an account</a> · <a href="/login">Sign in</a></p>

      <p><small>Cards and printing are being built; accounts work today.</small></p>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
  }
  body {
    margin: 0 auto;
    max-width: 44rem;
    padding: 2rem 1.25rem 4rem;
    font: 1.125rem/1.6 system-ui, sans-serif;
    color: #111;
    background: #fff;
  }
  h1 {
    margin-bottom: 0;
    font-size: 2rem;
  }
  .points {
    padding-left: 0;
    list-style: none;
  }
  .points li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin-bottom: 0.5rem;
  }
  .points :global(svg) {
    flex: 0 0 auto;
    margin-top: 0.35rem;
    color: #555;
  }
  h1 img {
    display: block;
    max-width: 100%;
    height: auto;
  }
</style>
