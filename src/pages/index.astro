---
import Footer from '@/components/Footer.astro';
import Icon from '@/components/Icon.astro';
import { t } from '@/i18n/catalogue';
import { LANGUAGE_INFO } from '@/i18n/languages';
import '@/styles/app.css';
// Inlined, not an <img>: the wordmark is drawn with `currentColor`, and as an
// external image that resolves to the SVG's own default (black) — invisible on a
// dark page. Inline, it follows the theme like any other text.
import wordmark from '../../assets/brand/noka-wordmark.svg?raw';

// Landing page. Same token scale as the owner plane (ADR-028); no tracking, and no
// sponsor content until there is a sponsor (PLAN §18).
const locale = Astro.locals.locale;
const label = (key: Parameters<typeof t>[1]) => t(locale, key);
---

<!doctype html>
<html lang={LANGUAGE_INFO[locale].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{label('head.landing')}</title>
    <meta name="description" content={label('landing.metaDescription')} />
    <link rel="icon" href="data:," />
  </head>
  <body class="min-h-dvh">
    <main class="mx-auto flex w-full max-w-xl flex-col gap-10 px-4 py-12 sm:px-6 sm:py-16">
      <div class="space-y-3">
        <h1 class="w-52 text-fg [&_svg]:h-auto [&_svg]:w-full" set:html={wordmark} />
        <p class="text-sm tracking-wide text-fg-muted">{label('landing.tagline')}</p>
      </div>

      <p class="text-base leading-7 text-fg">{label('landing.intro')}</p>

      <ul class="space-y-3 text-sm leading-6">
        <li class="flex gap-3">
          <span class="mt-0.5 shrink-0 text-fg-muted"><Icon name="lock" size={18} /></span>
          <span>{label('landing.point.encrypted')}</span>
        </li>
        <li class="flex gap-3">
          <span class="mt-0.5 shrink-0 text-fg-muted"><Icon name="bars" size={18} /></span>
          <span>{label('landing.point.offline')}</span>
        </li>
        <li class="flex gap-3">
          <span class="mt-0.5 shrink-0 text-fg-muted"><Icon name="eye-off" size={18} /></span>
          <span>{label('landing.point.noTracking')}</span>
        </li>
      </ul>

      {
        Astro.url.searchParams.get('deleted') === '1' && (
          <p class="rounded-md border border-success/40 bg-success/10 px-3 py-2 text-sm text-success" role="status">
            {label('landing.deleted')}
          </p>
        )
      }

      <div class="flex flex-wrap items-center gap-3 rounded-lg border border-line bg-surface p-4">
        <a
          class="inline-flex h-9 items-center rounded-md border border-accent bg-accent px-3.5 text-sm font-medium text-accent-fg no-underline hover:opacity-90"
          href="/signup"
          ><span class="inline-flex items-center gap-2"><Icon name="plus" size={16} /> {label('landing.create')}</span></a
        >
        <a
          class="inline-flex h-9 items-center rounded-md border border-line-strong bg-surface px-3.5 text-sm font-medium text-fg no-underline hover:bg-muted"
          href="/login"
          ><span class="inline-flex items-center gap-2"><Icon name="logout" size={16} /> {label('landing.signIn')}</span></a
        >
        <p class="w-full text-xs text-fg-muted sm:w-auto sm:pl-2">
          {label('landing.wip')}
        </p>
      </div>

      <Footer />
    </main>
  </body>
</html>
