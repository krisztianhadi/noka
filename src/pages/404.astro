---
import Plain from '@/layouts/Plain.astro';
import { t } from '@/i18n/catalogue';

/**
 * The owner plane's 404.
 *
 * It exists for two reasons that are not cosmetic. First, Astro's default is a bare
 * "Not Found" with no way back. Second — the one that matters — the responder plane must
 * never be reachable through this page: `/c/{unknown}` renders the PIN form, byte-identical
 * to a real card, so a stranger who mistypes a slug does not learn that the card is wrong,
 * and a *route* that does not exist is a different case with nothing to hide.
 */
const locale = Astro.locals.locale;
const label = (key: Parameters<typeof t>[1]) => t(locale, key);
---

<Plain title={label('error.pageNotFound')} theme={Astro.locals.theme}>
  <h1 class="text-xl font-semibold tracking-tight">{label('error.pageNotFound')}</h1>
  <p class="mt-3 text-sm leading-6 text-fg-muted">{label('error.pageNotFoundBody')}</p>
  <p class="mt-6">
    <a class="text-sm text-fg underline underline-offset-2" href="/">{label('error.backHome')}</a>
  </p>
</Plain>
