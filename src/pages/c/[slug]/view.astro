---
import Responder from '@/layouts/Responder.astro';
import { t, type MessageKey } from '@/i18n/catalogue';
import { LANGUAGE_INFO } from '@/i18n/languages';
import ChannelIcon from '@/components/ChannelIcon.astro';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import type { ContactView } from '@/lib/contacts';
import { channelHref, type Channel } from '@/lib/channels';
import {
  cardLanguages,
  findCardBySlug,
  loadResponderView,
  resolveLanguage,
  viewCookieStillValid,
} from '@/lib/responder';
import { LANG_COOKIE, VIEW_COOKIE, readViewToken } from '@/lib/view-cookie';

/**
 * The page the QR is for (§3, §9): contacts, notes, tap-to-call, in the card's
 * own language, with zero JavaScript.
 *
 * Without a valid cookie this is not an error — it is the PIN form, exactly as
 * if the URL had been opened for the first time.
 */
/**
 * What to offer for this contact.
 *
 * Someone who cannot speak or hear is not called: the call button is dropped entirely
 * (offering an action that cannot work is worse than offering fewer), text is added
 * first so it is the button the responder reaches for, and the messaging apps follow —
 * they all open a chat, which is the point.
 */
function offeredChannels(contact: ContactView): Channel[] {
  if (!contact.textOnly) return contact.channels;
  const services = contact.channels.filter((channel) => channel !== 'call');
  return ['sms', ...services];
}

const requestedSlug = Astro.params.slug ?? '';
const card = await findCardBySlug(requestedSlug);
const claims = readViewToken(Astro.cookies.get(VIEW_COOKIE)?.value);

if (!card || !viewCookieStillValid(claims, card)) {
  return Astro.redirect(`/c/${requestedSlug}`, 303);
}

const language = resolveLanguage(
  card,
  Astro.cookies.get(LANG_COOKIE)?.value,
  Astro.request.headers.get('accept-language'),
);
const label = (key: MessageKey) => t(language, key);
const { ownerName, contacts, notes } = await loadResponderView(card);
const offered = cardLanguages(card);
---

<Responder lang={LANGUAGE_INFO[language].htmlLang} title={label('view.heading')}>
  <h1>{label('view.heading')}</h1>
  {ownerName && <p class="owner">{ownerName}</p>}

  {
    contacts.map((contact) => (
      <div class="contact">
        <div class="name">{contact.name}</div>
        <div class="relation">{label(`relation.${contact.relation}` as MessageKey)}</div>
        {contact.spokenLanguages.length > 0 && (
          <div class="speaks">
            {label('view.speaks')}:{' '}
            {contact.spokenLanguages
              .map((code) => label(`spoken.${code}` as MessageKey))
              .join(' · ')}
          </div>
        )}
        <div class="phone">
          <a href={channelHref('call', contact.phoneE164)}>{contact.phoneDisplay}</a>
        </div>
        {contact.textOnly && (
          <p class="alert" role="note">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
              <path
                d="M4 5.5h16v10H12l-4.5 3.5v-3.5H4z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linejoin="round"></path>
              <path d="M8.5 10.5h7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
            </svg>
            <span>{label('view.text_only')}</span>
          </p>
        )}
        <div class="actions">
          {offeredChannels(contact).map((channel) => (
            <a class={`action ${channel}`} href={channelHref(channel, contact.phoneE164)}>
              <ChannelIcon channel={channel} size={20} />
              <span>{label(`channel.${channel}` as MessageKey)}</span>
            </a>
          ))}
        </div>
      </div>
    ))
  }

  {
    notes.length > 0 && (
      <>
        <h2 class="notes-heading">{label('view.notes')}</h2>
        <div class="notes">{notes}</div>
      </>
    )
  }

  <form method="post" action={`/c/${card.slug}/hide`}>
    <button type="submit" class="hide">
      {label('view.hide')}
    </button>
  </form>

  {
    offered.length > 1 && (
      <LanguageSwitcher action={`/c/${card.slug}/lang`} languages={offered} current={language} />
    )
  }
</Responder>
