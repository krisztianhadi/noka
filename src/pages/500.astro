---
import Plain from '@/layouts/Plain.astro';
import { t } from '@/i18n/catalogue';

/**
 * The owner plane's 500.
 *
 * Astro renders this page when a route throws, and it is the one page whose own
 * dependencies may be missing: an unhandled error can come from the middleware before it
 * has read the theme or the language. So it reads both defensively — `Plain` falls back to
 * English when the locale was never resolved — and it deliberately shows **no error
 * message, no stack and no identifier**: the person reading it can do nothing with any of
 * them, and an error string is a place where a payload ends up in a screenshot. The real
 * error goes to the server log, which is where the person who can act on it is looking.
 */
const locale = Astro.locals.locale;
const label = (key: Parameters<typeof t>[1]) => t(locale, key);
---

<Plain title={label('error.serverError')} theme={Astro.locals.theme}>
  <h1 class="text-xl font-semibold tracking-tight">{label('error.serverError')}</h1>
  <p class="mt-3 text-sm leading-6 text-fg-muted">{label('error.serverErrorBody')}</p>
  <p class="mt-6">
    <a class="text-sm text-fg underline underline-offset-2" href="/">{label('error.backHome')}</a>
  </p>
</Plain>
