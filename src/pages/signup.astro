---
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import Plain from '@/layouts/Plain.astro';
import { getAuth } from '@/lib/auth';
import { t } from '@/i18n/catalogue';
import { errorMessage, field, forbidden, isSameOrigin, readForm, redirectWithCookies } from '@/lib/http';

const locale = Astro.locals.locale;
const label = (key: Parameters<typeof t>[1]) => t(locale, key);

let errorKey: Parameters<typeof t>[1] | null = null;
let email = '';
let name = '';

if (Astro.request.method === 'POST') {
  if (!isSameOrigin(Astro.request)) return forbidden();

  const form = await readForm(Astro.request);
  if (!form) return forbidden();
  email = field(form, 'email');
  name = field(form, 'name');
  const password = field(form, 'password');
  const confirmation = field(form, 'password_confirm');

  // Industry standard for a reason: a typo in a password field locks the account
  // out of its own recovery flow.
  if (password !== confirmation) {
    errorKey = 'error.password-mismatch';
  } else {
    const response = await getAuth().api.signUpEmail({
    body: { email, password, name },
    asResponse: true,
  });

    if (response.ok) return redirectWithCookies('/dashboard', response);
    void (await errorMessage(response, ''));
    errorKey = 'error.signup-failed';
  }
}
---

<Plain title={label('head.signup')}>
  <h1 class="text-xl font-semibold tracking-tight">{label('auth.signup.title')}</h1>

  {
    errorKey && (
      <p class="error mt-4 rounded-md border px-3 py-2 text-sm border-danger/40 bg-danger/10 text-danger" role="alert">
        {label(errorKey)}
      </p>
    )
  }

  <form method="post" class="mt-6 space-y-4 rounded-lg border border-line bg-surface p-4 sm:p-5">
    <div>
      <label class="mb-1.5 block text-sm font-medium text-fg" for="name">{label('auth.signup.name')}</label>
      <input id="name" class="h-10 w-full rounded-md border border-line-strong bg-surface px-3 text-sm text-fg outline-none" name="name" type="text" required autocomplete="given-name" value={name} />
      <p class="mt-1.5 text-xs leading-5 text-fg-muted">{label('auth.signup.nameHint')}</p>
    </div>

    <div>
      <label class="mb-1.5 block text-sm font-medium text-fg" for="email">{label('auth.signup.email')}</label>
      <input id="email" class="h-10 w-full rounded-md border border-line-strong bg-surface px-3 text-sm text-fg outline-none" name="email" type="email" required autocomplete="email" value={email} />
    </div>

    <div>
      <label class="mb-1.5 block text-sm font-medium text-fg" for="password">{label('auth.signup.password')}</label>
      <input id="password" class="h-10 w-full rounded-md border border-line-strong bg-surface px-3 text-sm text-fg outline-none" name="password" type="password" required minlength="10" autocomplete="new-password" />
    </div>

    <div>
      <label class="mb-1.5 block text-sm font-medium text-fg" for="password_confirm">{label('auth.signup.passwordAgain')}</label>
      <input
        id="password_confirm"
        class="h-10 w-full rounded-md border border-line-strong bg-surface px-3 text-sm text-fg outline-none"
        name="password_confirm"
        type="password"
        required
        minlength="10"
        autocomplete="new-password"
      />
      <p class="mt-1.5 text-xs leading-5 text-fg-muted">{label('auth.signup.passwordHint')}</p>
    </div>

    <div class="flex justify-end">
      <Button type="submit"><Icon name="plus" size={16} /> {label('auth.signup.submit')}</Button>
    </div>
  </form>

  <p class="mt-4 text-sm text-fg-muted">
    {label('auth.signup.have')} <a class="text-fg" href="/login">{label('auth.login.link')}</a>
  </p>
</Plain>
