---
import Button from '@/components/Button.astro';
import ChannelIcon from '@/components/ChannelIcon.astro';
import ConfirmDialog from '@/components/ConfirmDialog.astro';
import ContactFields from '@/components/ContactFields.astro';
import ContactForm from '@/components/ContactForm.astro';
import Icon from '@/components/Icon.astro';
import DashboardBehavior from '@/components/DashboardBehavior.astro';
import Plain from '@/layouts/Plain.astro';
import { t } from '@/i18n/catalogue';
import { cardUrl, getCardForOwner, revealPin } from '@/lib/cards';
import { cardOrigin } from '@/lib/card-origin';
import { channelHref, type Channel } from '@/lib/channels';
import { MAX_CONTACTS, getNotes, listContacts } from '@/lib/contacts';
import { plural } from '@/lib/plural';
import { errorKey, noticeKey } from '@/lib/dashboard';
import { toggleTarget, type Theme } from '@/lib/theme';
import { flagForLanguage } from '@/lib/flags';
// Inlined so the mark follows the theme: as an <img> its own default colour shows through.
import wordmark from '../../../assets/brand/noka-wordmark.svg?raw';

/**
 * The whole owner plane on one page, in his order: contacts, then notes, then the
 * card. Everything else is a menu at the top (settings, dark mode, sign out) or a
 * kebab beside the thing it acts on.
 *
 * Layout rule (ADR-028): sections are cards on the page background, and only things
 * that actually float — menus and the modal — carry a shadow.
 */
const owner = Astro.locals.owner!;
const theme = Astro.locals.theme;
const locale = Astro.locals.locale;
const label = (key: Parameters<typeof t>[1], values?: Record<string, string | number>) =>
  t(locale, key, values);

const contacts = await listContacts(owner.id);
const notes = await getNotes(owner.id);
const card = await getCardForOwner(owner.id);

// Keys, not sentences: the catalogue renders them in the owner's language.
const notice = noticeKey(Astro.url.searchParams.get('notice'));
const error = errorKey(Astro.url.searchParams.get('error'));

const relationLabel = (relation: string) => label(`relation.${relation}` as 'relation.spouse');
const channelLabel = (channel: string) => label(`channel.${channel}` as 'channel.call');
const spokenLabel = (code: string) => label(`spoken.${code}` as 'spoken.en');

const nextTheme: Theme = toggleTarget(theme);

// The confirmation copy the modal shows, translated at render.
const LAST_CONTACT_WARNING = label('owner.contacts.deleteLastConfirm');
const NEW_CARD_WARNING = label('owner.card.newConfirm');
const DELETE_CARD_WARNING = label('owner.card.deleteConfirm');

// No colour in the shared string: `text-fg` here beat the destructive item's
// `text-danger` because both are one cascade layer and order decides, so "Delete
// contact" rendered in normal ink. Colour belongs to each item.
const menuItem =
  'menu-item flex w-full items-center gap-2 rounded-md px-2.5 py-2 text-left text-sm no-underline hover:bg-muted';
const cardClass = 'rounded-lg border border-line bg-surface p-4 sm:p-5';
const sectionTitle = 'text-sm font-semibold uppercase tracking-wide text-fg-muted';
const summaryIcon =
  'flex size-8 cursor-pointer list-none items-center justify-center rounded-md text-fg-muted marker:content-none hover:bg-muted hover:text-fg';
const panelClass =
  'panel absolute right-0 z-20 mt-1 min-w-52 rounded-lg border border-line bg-surface p-1 shadow-float';
---

<Plain title={label('head.dashboard')} theme={theme} wide wider>
  <ConfirmDialog />
  <DashboardBehavior />

  <header
    class="mb-6 flex items-center justify-between gap-3 rounded-lg border border-line bg-surface px-4 py-3"
  >
    <a
      class="w-16 text-fg no-underline [&_svg]:h-auto [&_svg]:w-full"
      href="/dashboard"
      aria-label="noka"
      set:html={wordmark}
    />
    <details class="menu relative">
      <summary
        class="flex size-9 cursor-pointer list-none items-center justify-center rounded-md border border-line bg-surface text-fg marker:content-none hover:bg-muted"
        aria-label={label('owner.menu')}
      >
        <Icon name="menu" size={20} />
      </summary>
      <div class={`${panelClass} min-w-56`}>
        <p class="mb-1 border-b border-line px-2.5 pt-1.5 pb-2.5">
          <span class="block text-sm font-medium">{owner.name}</span>
          <span class="block text-xs break-all text-fg-muted">{owner.email}</span>
        </p>
        <a class={`${menuItem} text-fg`} href="/dashboard/settings"><Icon name="settings" size={16} /> {label('owner.settings')}</a>
        <form method="post" action="/dashboard/theme">
          <input type="hidden" name="theme" value={nextTheme} />
          <button class={`${menuItem} text-fg`} type="submit">
            <Icon name={theme === 'dark' ? 'sun' : 'moon'} size={16} />
            {theme === 'dark' ? label('owner.lightMode') : label('owner.darkMode')}
          </button>
        </form>
        <form method="post" action="/logout">
          <button class={`${menuItem} text-fg`} type="submit"><Icon name="logout" size={16} /> {label('owner.signOut')}</button>
        </form>
      </div>
    </details>
  </header>

  {
    notice && (
      <p class="notice mb-6 rounded-md border border-success/40 bg-success/10 px-3 py-2 text-sm text-success" role="status">
        {label(notice)}
      </p>
    )
  }
  {
    error && (
      <p class="error mb-6 rounded-md border border-danger/40 bg-danger/10 px-3 py-2 text-sm text-danger" role="alert">
        {label(error)}
      </p>
    )
  }

  <div class="grid items-start gap-6 xl:grid-cols-[minmax(0,1fr)_22rem]">
  <div class="space-y-6">
  <section id="contacts" class="space-y-4">
    <div class="flex items-baseline justify-between gap-3">
      <h1 class="text-xl font-semibold tracking-tight">{label('owner.contacts.title')}</h1>
      {
        contacts.length > 0 && (
          <span class="text-xs text-fg-muted">
            {plural(locale, 'owner.contacts.count', contacts.length)}
          </span>
        )
      }
    </div>

    {
      /* Nothing at all is said about having no contacts: the form below is the answer, and a
         sentence explaining that a card needs a contact explained a rule nobody asked about. */
      contacts.length > 0 && (
        <ul class="contacts divide-y divide-line overflow-hidden rounded-lg border border-line bg-surface">
          {contacts.map((contact) => (
            <li class="p-4">
              <div class="who-row flex items-start justify-between gap-3">
                <div class="min-w-0 flex-1">
                  <p class="name min-w-0 flex-1 text-base leading-6 font-semibold break-words">{contact.name}</p>
                  <p class="meta mt-1 flex flex-wrap items-baseline gap-x-2 text-sm text-fg-muted">
                    <span class="relation">{relationLabel(contact.relation)}</span>
                    <span aria-hidden="true">·</span>
                    {/* The handset is decorative and lives outside the link: inside it, the
                        underline drew a stray line beneath the glyph. */}
                    <span class="phone-row">
                      <span class="phone-mark" aria-hidden="true"></span>
                      <a class="phone font-mono text-sm text-fg" href={channelHref('call', contact.phoneE164)}>
                        {contact.phoneDisplay}
                      </a>
                    </span>
                  </p>
                </div>

                <div class="flex shrink-0 items-center gap-1">
                  <details class="menu kebab relative">
                    <summary class={summaryIcon} aria-label={label('owner.contacts.actions', { name: contact.name })}>
                      <Icon name="dots" size={18} />
                    </summary>
                    <div class={panelClass}>
                      <!-- Edit lives in the menu like every other row action. The form it
                           opens is in the page below the contact, never inside this panel. -->
                      <button
                        class={`${menuItem} text-fg`}
                        type="button"
                        data-edit-trigger
                        aria-label={label('owner.contacts.edit', { name: contact.name })}
                      >
                        <Icon name="edit" size={16} /> {label('owner.contacts.editMenu')}
                      </button>
                      <form
                        method="post"
                        action={`/dashboard/contacts/${contact.id}/delete`}
                        data-confirm={contacts.length === 1 ? LAST_CONTACT_WARNING : label('owner.contacts.deleteConfirm')}
                        data-confirm-title={contacts.length === 1
                          ? label('owner.contacts.deleteLastTitle')
                          : label('owner.contacts.deleteTitle')}
                        data-confirm-ok={label('owner.contacts.deleteOk')}
                      >
                        <button class={`${menuItem} danger text-danger hover:bg-danger/10`} type="submit">
                          <Icon name="trash" size={16} /> {label('owner.contacts.delete')}
                        </button>
                      </form>
                    </div>
                  </details>
                </div>
              </div>

              <dl class="mt-3 space-y-2 text-sm">
                <div class="flex flex-wrap items-center gap-1.5">
                  <dt class="text-xs font-medium tracking-wide text-fg-muted uppercase">{label('owner.contacts.services')}</dt>
                  <dd class="tags flex flex-wrap gap-1">
                    {contact.textOnly && (
                      <span class="tag text-only inline-flex min-h-6 items-center gap-1 rounded-full border border-line-strong bg-muted px-2 py-0.5 text-xs font-medium">
                        <span aria-hidden="true">🔇</span> {label('owner.contacts.textOnly')}
                      </span>
                    )}
                    {contact.channels.map((channel: Channel) => (
                      <span class="tag inline-flex min-h-6 items-center gap-1 min-h-6 rounded-full border border-line px-2 py-0.5 text-xs">
                        <ChannelIcon channel={channel} size={13} branded />
                        {channelLabel(channel)}
                      </span>
                    ))}
                  </dd>
                </div>
                {contact.spokenLanguages.length > 0 && (
                  <div class="flex flex-wrap items-center gap-1.5">
                    <dt class="text-xs font-medium tracking-wide text-fg-muted uppercase">{label('owner.contacts.spoken')}</dt>
                    <dd class="speaks flex flex-wrap gap-1">
                      {contact.spokenLanguages.map((code) => (
                        <span class="tag inline-flex items-center gap-1 rounded-full border border-dashed border-line px-2 py-0.5 text-xs text-fg-muted">
                          <span aria-hidden="true">{flagForLanguage(code)}</span>
                          <span>{spokenLabel(code)}</span>
                        </span>
                      ))}
                    </dd>
                  </div>
                )}
              </dl>

              <details class="edit-form mt-3">
                {/* One edit affordance, the pencil in the row: this summary exists so
                    the form stays keyboard-reachable, but it is not a second button. */}
                <summary class="sr-only">{label('owner.contacts.edit', { name: contact.name })}</summary>
                <div class="mt-3 border-t border-line pt-4">
                  <ContactForm
                    action={`/dashboard/contacts/${contact.id}/edit`}
                    contact={contact}
                    submitLabel={label('owner.contacts.saveSubmit')}
                  />
                </div>
              </details>
            </li>
          ))}
        </ul>
      )
    }

    {
      contacts.length === 0 ? (
        /* First run: the contact and the note in one form with one save button. They are two
           tables and two writes, but the owner typed one screen, so they get one button — and
           saving it makes the card, so there is nothing else to press. */
        <div class={cardClass}>
          <h2 class={`${sectionTitle} mb-4`}>{label('owner.contacts.addTitle')}</h2>
          <form method="post" action="/dashboard/start" class="contact-form space-y-6">
            <ContactFields />
            {
              /* A note that survived a deleted contact is still the owner's note: it keeps its
                 own card below, and asking for it again here would be the same note twice. */
              !notes && (
            <div class="border-t border-line pt-5">
              <h3 class="text-sm font-semibold text-fg">{label('owner.notes.title')}</h3>
              <label class="mt-3 block">
                <span class="mb-1.5 flex items-baseline gap-2 text-sm font-medium text-fg">
                  {label('owner.notes.label')}
                  <span class="text-xs font-normal text-fg-muted">{label('owner.notes.optional')}</span>
                </span>
                <textarea
                  id="notes"
                  class="w-full rounded-md border border-line-strong bg-surface p-3 text-sm leading-6 text-fg outline-none"
                  name="notes"
                  rows="3"
                  maxlength="2000"></textarea>
              </label>
              <p class="mt-1.5 text-xs leading-5 text-fg-muted">{label('owner.notes.hint')}</p>
            </div>
              )
            }
            <div class="flex justify-end">
              <Button type="submit"><Icon name="check" size={16} /> {label('owner.start.save')}</Button>
            </div>
          </form>
        </div>
      ) : (
        contacts.length >= MAX_CONTACTS ? (
          <p class="rounded-lg border border-line bg-surface px-4 py-3 text-sm text-fg-muted">
            {label('owner.contacts.limit')}
          </p>
        ) : (
        <details class="add-more overflow-hidden rounded-lg border border-line bg-surface">
          <summary class="flex cursor-pointer list-none items-center justify-center gap-2 px-4 py-3 text-sm font-medium marker:content-none hover:bg-muted">
            <Icon name="plus" size={16} /> {label('owner.contacts.addAnother')}
          </summary>
          <div class="border-t border-line p-4">
            <ContactForm action="/dashboard/contacts/new" submitLabel={label('owner.contacts.addSubmit')} />
          </div>
        </details>
        )
      )
    }
  </section>

  {
    (contacts.length > 0 || notes) && (
  <section id="notes-section">
    {/* `editable` is the scope the kebab's Edit looks in, exactly as a contact row is the
        scope for its own: the form it opens lives inside this card. */}
    <div class={`${cardClass} editable`}>
      <div class="flex items-start justify-between gap-3">
        <h2 class={sectionTitle}>{label('owner.notes.title')}</h2>
        {
          notes && (
            /* Same shape as a contact row: the note is read here, and the kebab holds the two
               things that change it. The form it reveals lives in the page, never in the panel. */
            <details class="menu kebab relative">
              <summary class={summaryIcon} aria-label={label('owner.notes.actions')}>
                <Icon name="dots" size={18} />
              </summary>
              <div class={panelClass}>
                <button
                  class={`${menuItem} text-fg`}
                  type="button"
                  data-edit-trigger
                  aria-label={label('owner.notes.edit')}
                >
                  <Icon name="edit" size={16} /> {label('owner.notes.edit')}
                </button>
                <form
                  method="post"
                  action="/dashboard/notes/delete"
                  data-confirm={label('owner.notes.deleteConfirm')}
                  data-confirm-title={label('owner.notes.deleteTitle')}
                  data-confirm-ok={label('owner.notes.deleteOk')}
                >
                  <button class={`${menuItem} danger text-danger hover:bg-danger/10`} type="submit">
                    <Icon name="trash" size={16} /> {label('owner.notes.delete')}
                  </button>
                </form>
              </div>
            </details>
          )
        }
      </div>

      {
        notes ? (
          <div>
            <p class="notes mt-3 text-base leading-7 break-words whitespace-pre-wrap text-fg">{notes}</p>
            <details class="edit-form mt-4">
              <summary class="sr-only">{label('owner.notes.edit')}</summary>
              <form method="post" action="/dashboard/notes" class="space-y-3 border-t border-line pt-4">
                <label class="block" for="notes">
                  <span class="mb-1.5 block text-sm font-medium text-fg">{label('owner.notes.label')}</span>
                  <textarea
                    id="notes"
                    class="w-full rounded-md border border-line-strong bg-surface p-3 text-sm leading-6 text-fg outline-none"
                    name="notes"
                    rows="3"
                    maxlength="2000">{notes}</textarea>
                </label>
                <p class="text-xs leading-5 text-fg-muted">{label('owner.notes.hint')}</p>
                <div class="flex items-center justify-end gap-2">
                  <a
                    class="inline-flex h-9 items-center rounded-md border border-line-strong bg-surface px-3.5 text-sm font-medium text-fg no-underline hover:bg-muted"
                    href="/dashboard"
                    data-cancel
                  >
                    {label('form.cancel')}
                  </a>
                  <Button type="submit"><Icon name="check" size={16} /> {label('owner.notes.save')}</Button>
                </div>
              </form>
            </details>
          </div>
        ) : (
          /* Adding a note looks like adding a contact: the same disclosure, closed until asked
             for, so the page is a list of what exists rather than a form waiting to be filled. */
          <details class="add-more mt-3 -mb-1 overflow-hidden rounded-lg border border-line bg-surface">
            <summary class="flex cursor-pointer list-none items-center justify-center gap-2 px-4 py-3 text-sm font-medium marker:content-none hover:bg-muted">
              <Icon name="plus" size={16} /> {label('owner.notes.add')}
            </summary>
            <form method="post" action="/dashboard/notes" class="space-y-3 border-t border-line p-4">
              <label class="block" for="notes">
                <span class="mb-1.5 block text-sm font-medium text-fg">{label('owner.notes.label')}</span>
                <textarea
                  id="notes"
                  class="w-full rounded-md border border-line-strong bg-surface p-3 text-sm leading-6 text-fg outline-none"
                  name="notes"
                  rows="3"
                  maxlength="2000"></textarea>
              </label>
              <p class="text-xs leading-5 text-fg-muted">{label('owner.notes.hint')}</p>
              <div class="flex justify-end">
                <Button type="submit"><Icon name="check" size={16} /> {label('owner.notes.save')}</Button>
              </div>
            </form>
          </details>
        )
      }
    </div>
  </section>
    )
  }

  </div>

  <!-- The card is the output of the workflow beside it, so on a wide screen it parks: the
       contacts an owner is editing are what they are looking at, and the card follows. -->
  {
    /* Three states. A real card. A note that outlived its contacts: the card keeps its place on
       the page as a placeholder, saying what it is waiting for, because the note beside it is
       still going to the card page. And nothing at all: on a first run the form's own save makes
       the card, so a block explaining that had nothing to say. */
    (card || notes) && (
  <section id="card" class="xl:sticky xl:top-6">
    <div class="rounded-lg border border-ink bg-ink p-5 text-ink-fg">
      <div class="section-head mb-4 flex items-center justify-between gap-3">
        <h2 class="text-sm font-semibold tracking-wide text-ink-fg/70 uppercase">{label('owner.card.title')}</h2>
        {
          card && (
            <details class="menu kebab relative">
              <summary class={summaryIcon} aria-label={label('owner.card.actions')}>
                <Icon name="dots" size={18} />
              </summary>
              <div class={`${panelClass} min-w-56`}>
                <form
                  method="post"
                  action="/dashboard/card/new"
                  data-confirm={NEW_CARD_WARNING}
                  data-confirm-title={label('owner.card.newTitle')}
                  data-confirm-ok={label('owner.card.newOk')}
                >
                  <button class={`${menuItem} text-fg`} type="submit"><Icon name="refresh" size={16} /> {label('owner.card.new')}</button>
                </form>
                <form
                  method="post"
                  action="/dashboard/card/delete"
                  data-confirm={DELETE_CARD_WARNING}
                  data-confirm-title={label('owner.card.deleteTitle')}
                  data-confirm-ok={label('owner.card.deleteOk')}
                >
                  <button class={`${menuItem} danger text-danger hover:bg-danger/10`} type="submit">
                    <Icon name="trash" size={16} /> {label('owner.card.delete')}
                  </button>
                </form>
              </div>
            </details>
          )
        }
      </div>

      {
        !card && (
          <div class="space-y-5">
            {/* The same footprint as the real card, empty: the note below still goes to the card
                page, so the card keeps its place and says what it is waiting for. */}
            <div class="mx-auto flex aspect-[638/1011] w-full max-w-[9rem] items-center justify-center rounded-md border border-dashed border-ink-fg/30 bg-white/5 p-3">
              <p class="text-center text-xs leading-5 text-ink-fg/50">{label('owner.card.placeholder')}</p>
            </div>
            {contacts.length > 0 ? (
              <div class="space-y-4">
                <p class="text-sm text-ink-fg/70">{label('owner.card.ready')}</p>
                <form method="post" action="/dashboard/card/create">
                  <Button type="submit">
                    <Icon name="card" size={16} /> {label('owner.card.make')}
                  </Button>
                </form>
              </div>
            ) : (
              <p class="text-sm text-ink-fg/70">{label('owner.card.needsContact')}</p>
            )}
          </div>
        )
      }

      {
        card && (
          <div class="space-y-5">
            <!-- The preview sits on white paper, because that is what the owner will hold.
                 Small: in a status column this is a reminder of what the card is, and the
                 owner prints from the image itself. -->
            <div class="rounded-md bg-white p-2">
              <img
                class="preview mx-auto w-full max-w-[9rem] rounded-sm"
                src="/dashboard/card/card.jpg"
                alt={label('owner.card.imageAlt')}
                width="638"
                height="1011"
              />
            </div>
            <div class="min-w-0 space-y-4">
              <div>
                <p class="text-xs font-medium tracking-wide text-ink-fg/60 uppercase">{label('owner.card.pin')}</p>
                <p class="pin mt-1 font-mono text-2xl leading-none font-semibold tracking-[0.08em]">{revealPin(card)}</p>
              </div>
              <div>
                <p class="text-xs font-medium tracking-wide text-ink-fg/60 uppercase">{label('owner.card.link')}</p>
                <p class="url mt-1 font-mono text-xs break-all">
                  {/* Relative on purpose: this link is opened from whatever address the owner is
                      using, so it cannot be wrong. The text beside it is the URL the card carries. */}
                  <a class="text-ink-fg/80 underline underline-offset-2" href={`/c/${card.slug}`}>
                    {cardUrl(card, cardOrigin(Astro.request))}
                  </a>
                </p>
              </div>
              <div class="space-y-2">
                <p class="text-xs font-medium tracking-wide text-ink-fg/60 uppercase">
                  {label('owner.card.printTitle')}
                </p>
                {/* Three files, because there are three ways to print: a print shop wants the
                    card and nothing else, a home printer wants A4, and a stack wants the sheet.
                    The A4 one card is the default — it is what a home printer does — so it is
                    the mustard one. */}
                <a
                  class="flex h-9 items-center justify-between gap-2 rounded-md border border-mark bg-mark px-3 text-sm font-medium text-mark-fg no-underline hover:brightness-[1.03]"
                  href="/dashboard/card/pdf?layout=a4"
                  target="_blank"
                  rel="noopener"
                >
                  {label('owner.card.printA4')}
                  <span class="text-mark-fg/70">PDF</span>
                </a>
                <a
                  class="flex h-9 items-center justify-between gap-2 rounded-md border border-ink-fg/25 px-3 text-sm font-medium text-ink-fg no-underline hover:bg-white/10"
                  href="/dashboard/card/pdf?layout=card"
                  target="_blank"
                  rel="noopener"
                >
                  {label('owner.card.printCard')}
                  <span class="text-ink-fg/50">54 × 86 mm</span>
                </a>
                <a
                  class="flex h-9 items-center justify-between gap-2 rounded-md border border-ink-fg/25 px-3 text-sm font-medium text-ink-fg no-underline hover:bg-white/10"
                  href="/dashboard/card/pdf?layout=sheet"
                  target="_blank"
                  rel="noopener"
                >
                  {label('owner.card.printSheet')}
                  <span class="text-ink-fg/50">PDF</span>
                </a>
              </div>

              <p class="text-xs leading-5 text-ink-fg/60">{label('owner.card.printHint')}</p>
              <a
                class="text-xs text-ink-fg/60 underline underline-offset-2 hover:text-ink-fg"
                href="/dashboard/card/card.jpg"
                target="_blank"
                rel="noopener"
              >
                {label('owner.card.openImage')} (JPG)
              </a>
            </div>
          </div>
        )
      }
    </div>
  </section>
    )
  }
  </div>
</Plain>
