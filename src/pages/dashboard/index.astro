---
import ConfirmDialog from '@/components/ConfirmDialog.astro';
import ContactForm from '@/components/ContactForm.astro';
import Icon from '@/components/Icon.astro';
import Plain from '@/layouts/Plain.astro';
import { MESSAGES } from '@/i18n/catalogue';
import { cardUrl, countContacts, getCardForOwner, revealPin } from '@/lib/cards';
import { channelHref, type Channel } from '@/lib/channels';
import { getNotes, listContacts } from '@/lib/contacts';
import { errorMessage, noticeMessage } from '@/lib/dashboard';
import { toggleTarget, type Theme } from '@/lib/theme';

/**
 * The whole owner plane on one page, in his order: contacts, then notes, then the
 * card. Everything else is a menu at the top (settings, dark mode, sign out) or a
 * kebab beside the thing it acts on, so nothing competes with the content.
 */
const owner = Astro.locals.owner!;
const theme = Astro.locals.theme;

const contacts = await listContacts(owner.id);
const notes = await getNotes(owner.id);
const card = await getCardForOwner(owner.id);
const count = await countContacts(owner.id);

const notice = noticeMessage(Astro.url.searchParams.get('notice'));
const error = errorMessage(Astro.url.searchParams.get('error'));

const relationLabel = (relation: string) => MESSAGES.en[`relation.${relation}` as 'relation.spouse'];
const channelLabel = (channel: string) => MESSAGES.en[`channel.${channel}` as 'channel.call'];
const spokenLabel = (code: string) => MESSAGES.en[`spoken.${code}` as 'spoken.en'];

const nextTheme: Theme = toggleTarget(theme);

const LAST_CONTACT_WARNING =
  'This is your last contact, so deleting it will also delete your card and its link. ' +
  'Anyone holding the printed card will find nothing until you add a contact and make a new card. Delete both?';
const NEW_CARD_WARNING =
  'A new card gets a new link and a new PIN. Anything already printed stops working immediately. Continue?';
const DELETE_CARD_WARNING =
  'Delete the card and its link? Your contacts and notes are kept, and you can make a new card later.';
---

<Plain title="Your noka" theme={theme}>
  <ConfirmDialog />
  <header class="top">
    <a class="brand" href="/dashboard">noka</a>
    <details class="menu">
      <summary aria-label="Menu"><Icon name="menu" size={22} /></summary>
      <div class="panel">
        <p class="who">
          <strong>{owner.name}</strong>
          <span class="muted">{owner.email}</span>
        </p>
        <a href="/dashboard/settings"><Icon name="settings" /> Settings</a>
        <form method="post" action="/dashboard/theme">
          <input type="hidden" name="theme" value={nextTheme} />
          <button type="submit" class="menu-item">
            <Icon name={theme === 'dark' ? 'sun' : 'moon'} />
            {theme === 'dark' ? 'Light mode' : 'Dark mode'}
          </button>
        </form>
        <form method="post" action="/logout">
          <button type="submit" class="menu-item"><Icon name="logout" /> Sign out</button>
        </form>
      </div>
    </details>
  </header>

  {notice && <p class="notice" role="status">{notice}</p>}
  {error && <p class="error" role="alert">{error}</p>}

  <section id="contacts">
    <h1>Emergency contacts</h1>

    {
      contacts.length === 0 ? (
        <p>Nobody yet. Add the person a responder should call — a card cannot exist until one does.</p>
      ) : (
        <ul class="contacts">
          {contacts.map((contact) => (
            <li>
              <div class="who-row">
                <div>
                  <p class="name">{contact.name}</p>
                  <p class="meta">{relationLabel(contact.relation)}</p>
                  <p class="meta">
                    <a class="phone" href={channelHref('call', contact.phoneE164)}>
                      {contact.phoneDisplay}
                    </a>
                  </p>
                  <p class="tags">
                    {contact.channels.map((channel: Channel) => (
                      <span class="tag">{channelLabel(channel)}</span>
                    ))}
                    {contact.spokenLanguages.map((code) => (
                      <span class="tag muted">{spokenLabel(code)}</span>
                    ))}
                  </p>
                </div>

                <details class="menu kebab">
                  <summary aria-label={`Actions for ${contact.name}`}><Icon name="dots" /></summary>
                  <div class="panel">
                    <details class="submenu">
                      <summary class="menu-item"><Icon name="edit" /> Edit contact</summary>
                      <ContactForm
                        action={`/dashboard/contacts/${contact.id}/edit`}
                        contact={contact}
                        submitLabel="Save changes"
                      />
                    </details>
                    <form
                      method="post"
                      action={`/dashboard/contacts/${contact.id}/delete`}
                      data-confirm={contacts.length === 1 ? LAST_CONTACT_WARNING : 'Delete this contact?'}
                      data-confirm-title={contacts.length === 1 ? 'Delete contact and card?' : 'Delete contact?'}
                      data-confirm-ok="Delete"
                    >
                      <button type="submit" class="menu-item danger">
                        <Icon name="trash" /> Delete contact
                      </button>
                    </form>
                  </div>
                </details>
              </div>
            </li>
          ))}
        </ul>
      )
    }

    {
      contacts.length === 0 ? (
        <>
          <h2>Add a contact</h2>
          <ContactForm action="/dashboard/contacts/new" submitLabel="Add contact" />
        </>
      ) : (
        <details class="add-more">
          <summary class="button secondary">Add another contact</summary>
          <ContactForm action="/dashboard/contacts/new" submitLabel="Add contact" />
        </details>
      )
    }
  </section>

  <section id="notes-section">
    <h2>Notes for a responder</h2>
    <form method="post" action="/dashboard/notes">
      <label for="notes">Notes</label>
      <textarea id="notes" name="notes" rows="5" maxlength="2000">{notes}</textarea>
      <p class="note">
        Shown under the contacts on the card page. Where the medication is, who to call first. Do not
        enter anyone else's data.
      </p>
      <button type="submit">Save notes</button>
    </form>
  </section>

  <section id="card">
    <div class="section-head">
      <h2>Your card</h2>
      {
        card && (
          <details class="menu kebab">
            <summary aria-label="Card actions"><Icon name="dots" /></summary>
            <div class="panel">
              <form
                method="post"
                action="/dashboard/card/new"
                data-confirm={NEW_CARD_WARNING}
                data-confirm-title="Make a new card?"
                data-confirm-ok="New card"
              >
                <button type="submit" class="menu-item"><Icon name="refresh" /> New card</button>
              </form>
              <form
                method="post"
                action="/dashboard/card/delete"
                data-confirm={DELETE_CARD_WARNING}
                data-confirm-title="Delete this card?"
                data-confirm-ok="Delete card"
              >
                <button type="submit" class="menu-item danger"><Icon name="trash" /> Delete card</button>
              </form>
            </div>
          </details>
        )
      }
    </div>

    {
      !card && (
        <>
          <p>
            {count === 0
              ? 'A card needs at least one contact behind it. Add someone above, then come back.'
              : 'Ready. The card gets a link and a six-digit PIN, and it is live immediately.'}
          </p>
          <form method="post" action="/dashboard/card/create">
            <button type="submit" disabled={count === 0}>
              Make my card
            </button>
          </form>
        </>
      )
    }

    {
      card && (
        <>
          <img
            class="preview"
            src="/dashboard/card/card.jpg"
            alt="Your card: the five-language heading, a QR code, the PIN and the noka wordmark"
            width="638"
            height="1011"
          />
          <p class="pin">{revealPin(card)}</p>
          <p class="url">
            <a href={cardUrl(card)}>{cardUrl(card)}</a>
          </p>
          <p class="note">
            <a href="/dashboard/card/card.jpg" target="_blank" rel="noopener">
              <Icon name="print" size={16} /> Open the card image in a new tab
            </a>
          </p>
          <p class="note">
            Print the image above, or copy the link and PIN by hand. The QR points at the link.
          </p>
        </>
      )
    }
  </section>


  <style>
    .top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 1.5rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--line);
    }
    .brand {
      font-weight: 700;
      letter-spacing: 0.02em;
      text-decoration: none;
    }
    .menu {
      position: relative;
    }
    .menu > summary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.5rem;
      height: 2.5rem;
      cursor: pointer;
      list-style: none;
      border: 1px solid var(--line);
      border-radius: 6px;
      color: var(--fg);
    }
    .menu > summary::-webkit-details-marker {
      display: none;
    }
    .menu[open] > summary {
      border-color: var(--line-strong);
    }
    .panel {
      position: absolute;
      right: 0;
      z-index: 10;
      min-width: 16rem;
      margin-top: 0.35rem;
      padding: 0.6rem;
      background: var(--bg-raised);
      border: 1px solid var(--line-strong);
      border-radius: 6px;
      box-shadow: 0 8px 24px rgb(0 0 0 / 25%);
    }
    .panel .who {
      display: flex;
      flex-direction: column;
      margin: 0 0 0.5rem;
      padding: 0 0.5rem 0.5rem;
      border-bottom: 1px solid var(--line);
    }
    .panel .muted {
      color: var(--fg-muted);
      font-size: 0.9rem;
      word-break: break-all;
    }
    .panel a,
    .menu-item {
      display: block;
      width: 100%;
      margin: 0;
      padding: 0.5rem;
      font: inherit;
      font-weight: 500;
      text-align: left;
      color: var(--fg);
      background: none;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      text-decoration: none;
    }
    .panel a:hover,
    .menu-item:hover {
      background: var(--line);
    }
    .menu-item.danger {
      color: var(--danger);
    }
    .submenu > summary {
      list-style: none;
    }
    .submenu > summary::-webkit-details-marker {
      display: none;
    }
    .submenu .contact-form {
      padding: 0.5rem;
    }
    section {
      margin-top: 2.5rem;
      padding-top: 1.25rem;
      border-top: 1px solid var(--line);
    }
    .section-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .section-head h2 {
      margin: 0;
    }
    h1 {
      font-size: 1.5rem;
    }
    h2 {
      font-size: 1.25rem;
    }
    .contacts {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .contacts > li {
      padding: 1rem 0;
      border-bottom: 1px solid var(--line);
    }
    .who-row {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 0.75rem;
    }
    .name {
      margin: 0;
      font-size: 1.2rem;
      font-weight: 600;
    }
    .meta {
      margin: 0.15rem 0;
      color: var(--fg-muted);
    }
    .phone {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      color: var(--fg);
    }
    .tags {
      margin: 0.4rem 0 0;
    }
    .tag {
      display: inline-block;
      margin: 0 0.3rem 0.3rem 0;
      padding: 0.1rem 0.45rem;
      font-size: 0.85rem;
      border: 1px solid var(--line-strong);
      border-radius: 999px;
    }
    .tag.muted {
      border-style: dashed;
      color: var(--fg-muted);
    }
    .add-more {
      margin-top: 1.25rem;
    }
    .add-more > summary {
      list-style: none;
      margin-top: 0;
    }
    .add-more > summary::-webkit-details-marker {
      display: none;
    }
    .add-more[open] > summary {
      margin-bottom: 0.5rem;
    }
    .preview {
      display: block;
      width: min(100%, 260px);
      height: auto;
      margin: 0.75rem 0 1rem;
      border: 1px solid var(--line);
    }
    .pin {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 2rem;
      letter-spacing: 0.12em;
      margin: 0.25rem 0;
    }
    .url {
      margin: 0.25rem 0;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      word-break: break-all;
    }
    .url a {
      text-decoration: underline;
      text-underline-offset: 2px;
    }
    @media (max-width: 30rem) {
      .panel {
        min-width: min(16rem, 80vw);
      }
    }
  </style>
</Plain>
