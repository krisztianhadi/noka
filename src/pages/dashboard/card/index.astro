---
import Plain from '@/layouts/Plain.astro';
import { cardUrl, contactCount, createCardForOwner, getCardForOwner, revealPin } from '@/lib/cards';
import { ownerRedirect } from '@/lib/dashboard';
import { field, forbidden, isSameOrigin } from '@/lib/http';

const owner = Astro.locals.owner!;

if (Astro.request.method === 'POST') {
  if (!isSameOrigin(Astro.request)) return forbidden();
  const form = await Astro.request.formData();
  if (field(form, 'action') === 'create') await createCardForOwner(owner.id);
  return ownerRedirect('/dashboard/card?notice=created');
}

const card = await getCardForOwner(owner.id);
const contacts = card ? await contactCount(card.id) : 0;

const NOTICES: Record<string, string> = {
  created: 'Card created. Give it a PIN you can read, then add a contact to switch it on.',
  activated: 'The card is on. Anyone with the card and the PIN can read your contacts.',
  deactivated: 'The card is off. The link stops working and nothing can be printed.',
  'pin-rotated': 'New PIN. Every card page that was already open has been signed out.',
  'slug-regenerated': 'New QR code. Any card printed before now is permanently dead.',
};

const ERRORS: Record<string, string> = {
  'no-card': 'Create the card first.',
  'no-contacts': 'Add at least one emergency contact before switching the card on.',
};

const notice = NOTICES[Astro.url.searchParams.get('notice') ?? ''];
const error = ERRORS[Astro.url.searchParams.get('error') ?? ''];
---

<Plain title="Your card — noka">
  <p><a href="/dashboard">← Dashboard</a></p>
  <h1>Your card</h1>

  {error && <p class="error" role="alert">{error}</p>}
  {notice && <p class="notice" role="status">{notice}</p>}

  {
    !card && (
      <>
        <p>
          One card per account. It carries a QR code and a six-digit PIN, and it stays reprintable from
          here for as long as it is active.
        </p>
        <form method="post">
          <input type="hidden" name="action" value="create" />
          <button type="submit">Create my card</button>
        </form>
      </>
    )
  }

  {
    card && (
      <>
        <p class="status">
          Status: <strong>{card.active ? 'Active' : 'Not active'}</strong>
          {contacts === 0 && ' — add a contact to switch it on'}
        </p>

        <h2>The PIN</h2>
        <p class="pin" aria-label="Your card PIN">
          {revealPin(card)}
        </p>
        <p class="note">
          Printed on the card next to the QR code. Anyone who scans the card and knows this PIN can read
          your contacts.
        </p>

        <h2>The link</h2>
        <p class="url">{cardUrl(card)}</p>
        <p class="note">This is what the QR code points at. Changing the domain later invalidates printed cards.</p>

        <h2>Manage</h2>
        <form method="post" action="/dashboard/card/rotate-pin">
          <button type="submit">New PIN</button>
        </form>
        <p class="note">Signs out every card page that is already open.</p>

        <form method="post" action="/dashboard/card/regenerate-slug">
          <button type="submit">New QR code</button>
        </form>
        <p class="note">For a card you lost. The old one stops working permanently.</p>

        {
          card.active ? (
            <form method="post" action="/dashboard/card/deactivate">
              <button type="submit">Switch off</button>
            </form>
          ) : (
            <form method="post" action="/dashboard/card/activate">
              <button type="submit" disabled={contacts === 0}>
                Switch on
              </button>
            </form>
          )
        }
        <p class="note">
          Printing and downloads arrive in a later phase. Until then the PIN above and the link are all you
          need.
        </p>
      </>
    )
  }
</Plain>

<style>
  h2 {
    margin-top: 2rem;
    font-size: 1.15rem;
  }
  .status {
    padding: 0.6rem 0.8rem;
    border: 1px solid #666;
    border-radius: 4px;
  }
  .pin {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 2.4rem;
    letter-spacing: 0.12em;
    margin: 0.5rem 0;
  }
  .url {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    word-break: break-all;
    margin: 0.5rem 0;
  }
  .notice {
    padding: 0.7rem 0.8rem;
    border: 2px solid #0a5;
    border-radius: 4px;
    color: #064;
  }
  button[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>
