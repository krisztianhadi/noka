---
import ConfirmDialog from '@/components/ConfirmDialog.astro';
import Icon from '@/components/Icon.astro';
import Plain from '@/layouts/Plain.astro';
import { errorMessage, noticeMessage } from '@/lib/dashboard';

/**
 * Settings: the account itself, nothing about the card. Reached from the top menu,
 * and kept deliberately small — email and password are the two things an owner can
 * actually change today.
 */
const owner = Astro.locals.owner!;
const notice = noticeMessage(Astro.url.searchParams.get('notice'));
const error = errorMessage(Astro.url.searchParams.get('error'));
---

<Plain title="Settings" theme={Astro.locals.theme}>
  <ConfirmDialog />
  <p class="back"><a href="/dashboard">← Back to your card</a></p>
  <h1>Settings</h1>

  {notice && <p class="notice" role="status">{notice}</p>}
  {error && <p class="error" role="alert">{error}</p>}

  <section>
    <h2><Icon name="mail" size={18} /> Email</h2>
    <form method="post" action="/dashboard/settings/email">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" required autocomplete="email" value={owner.email} />
      <p class="note">Used to sign in, and the one field stored in plain text (ADR-004).</p>
      <button type="submit">Update email</button>
    </form>
  </section>

  <section>
    <h2><Icon name="key" size={18} /> Password</h2>
    <form
      method="post"
      action="/dashboard/settings/password"
      data-confirm="Changing your password signs you out of every device, this one included. You will sign in again with the new password."
      data-confirm-title="Change your password?"
      data-confirm-ok="Change and sign out"
    >
      <label for="current_password">Current password</label>
      <input
        id="current_password"
        name="current_password"
        type="password"
        required
        autocomplete="current-password"
      />

      <label for="new_password">New password</label>
      <input
        id="new_password"
        name="new_password"
        type="password"
        required
        minlength="10"
        autocomplete="new-password"
      />

      <label for="new_password_confirm">New password again</label>
      <input
        id="new_password_confirm"
        name="new_password_confirm"
        type="password"
        required
        minlength="10"
        autocomplete="new-password"
      />
      <p class="note">At least 10 characters. Changing it signs out every other session.</p>
      <button type="submit">Update password</button>
    </form>
  </section>

  <p class="back"><a href="/logout">Sign out</a></p>
</Plain>

<style>
  .back {
    margin: 0 0 1rem;
  }
  section {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  h2 {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 1.2rem;
    margin-top: 0;
  }
</style>
