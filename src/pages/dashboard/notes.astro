---
import Plain from '@/layouts/Plain.astro';
import { getCardForOwner } from '@/lib/cards';
import { getNotes, listContacts, setNotes } from '@/lib/contacts';
import { ownerRedirect } from '@/lib/dashboard';
import { field, forbidden, isSameOrigin } from '@/lib/http';

const owner = Astro.locals.owner!;
const card = await getCardForOwner(owner.id);
if (!card) return ownerRedirect('/dashboard/card');

if (Astro.request.method === 'POST') {
  if (!isSameOrigin(Astro.request)) return forbidden();
  const form = await Astro.request.formData();
  await setNotes(card.id, field(form, 'notes'));
  return ownerRedirect('/dashboard/notes?notice=saved');
}

const notes = await getNotes(card.id);
const contacts = await listContacts(card.id);
---

<Plain title="Notes — noka">
  <p><a href="/dashboard">← Dashboard</a></p>
  <h1>Notes for a responder</h1>

  {Astro.url.searchParams.get('notice') === 'saved' && <p class="notice" role="status">Notes saved.</p>}

  <p>
    Free text, shown below the contacts on the card page. Plain words help: where the medication is, who to
    call first, what not to do.
  </p>

  <form method="post">
    <label for="notes">Notes</label>
    <textarea id="notes" name="notes" rows="6" maxlength="2000">{notes}</textarea>
    <button type="submit">Save notes</button>
  </form>

  <p class="note">
    Do not enter anyone else's data, and do not enter medical details you would not want a stranger holding
    your card to read. {contacts.length === 0 && 'Contacts come first — a card needs at least one.'}
  </p>
</Plain>

<style>
  textarea {
    width: 100%;
    box-sizing: border-box;
    padding: 0.7rem;
    font: inherit;
    border: 1px solid #666;
    border-radius: 4px;
  }
  .notice {
    padding: 0.7rem 0.8rem;
    border: 2px solid #0a5;
    border-radius: 4px;
    color: #064;
  }
</style>
