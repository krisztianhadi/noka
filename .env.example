# noka environment. Copy to .env and fill in — every value below is required
# except where noted, and the app refuses to start if one is missing (§4, §16).

# Postgres. Local dev: postgres://noka:noka@localhost:5433/noka
DATABASE_URL=

# Origin baked into every QR and printed instruction. Keep it short: every
# character is QR density, and changing it invalidates printed cards.
PUBLIC_CARD_ORIGIN=

# Signs the guest view cookie {slug, pin_version, exp}. 32+ random bytes,
# separate from the owner-plane secret on purpose (D22).
VIEW_COOKIE_SECRET=

# better-auth session signing/encryption (owner plane).
BETTER_AUTH_SECRET=

# Optional. better-auth's base URL for callbacks; defaults to PUBLIC_CARD_ORIGIN.
BETTER_AUTH_URL=

# AES-256-GCM keyring entry 1 for contact payloads and notes: 32 random bytes,
# base64. Never in the database, never in the repo, never in a log. Loss = data loss.
CONTACT_ENCRYPTION_KEY=

# HMAC key for the (dropped) email blind index and for IP hashing.
# Not rotatable in v1 (D23).
EMAIL_LOOKUP_KEY=
IP_HASH_KEY=

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Only used by scripts; the dev server port lives in astro.config.mjs.
# Railway supplies PORT at runtime.
PORT=3200

# Mail (2026-10-05). Optional, and the default is honest: with no provider configured,
# "sending" writes the message to the log, where a developer can click the link — which is
# also the only shape a solo self-hosted instance needs, since nobody has to receive mail
# to sign in.
#
# log | resend. Left unset, a RESEND_API_KEY means resend and no key means log.
# EMAIL_TRANSPORT=log
# Required when EMAIL_TRANSPORT=resend, and Resend refuses a sender on a domain the
# account has not verified. Example: noka <no-reply@nomorenames.studio>
# RESEND_API_KEY=
# EMAIL_FROM=

# Google sign-in (2026-10-05): both or neither. Set, the button appears on the sign-in and
# sign-up pages and better-auth handles the callback; unset, nothing changes.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
