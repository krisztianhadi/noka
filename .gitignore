# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# misc
.DS_Store
*.pem

# local env files
.env
.env*.local

# local GitHub and Railway access token (never commit)
/.github-token
/.git-credentials

# staging / scratch (never commit)
/.tmp-review/
/.tmp/
*.bak-*

# dependencies and build output
node_modules/
/dist/
/.astro/

# test output
/test-results/
/playwright-report/
/coverage/
